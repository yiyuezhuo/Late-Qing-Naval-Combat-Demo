    m_Metadata:
      m_Items: []
  - m_Id: 10965740016013312
    m_Localized: "## \u30ED\u30FC\u30AB\u30E9\u30A4\u30BA\u54C1\u8CEA\u306E\u554F\u984C\u306B\u3064\u3044\u3066\uFF1F\r\n\r\n\u30D9\u30FC\u30B9\u958B\u767A\u8A00\u8A9E\u306F\u82F1\u8A9E\u3067\u3042\u308A\u3001\u3053\u308C\u304C\u6700\u3082\u5B8C\u6210\u5EA6\u306E\u9AD8\u3044\u30D0\u30FC\u30B8\u30E7\u30F3\u3067\u3059\u3002\u4ED6\u8A00\u8A9E\u3067\u306E\u7FFB\u8A33\u306B\u7591\u554F\u304C\u3042\u308B\u5834\u5408\u306F\u3001\u307E\u305A\u82F1\u8A9E\u7248\u3067\u78BA\u8A8D\u3057\u3066\u304F\u3060\u3055\u3044\u3002\r\n\r\n\u73FE\u5728\u306E\u30ED\u30FC\u30AB\u30E9\u30A4\u30BA\u624B\u6CD5\uFF1A\r\n\r\n-
      **\u57FA\u672CUI**\uFF1A\u82F1\u8A9E\u7248\u3068\u7C21\u4F53\u5B57\u4E2D\u56FD\u8A9E\u7248\u306F\u624B\u4F5C\u696D\u3067\u4F5C\u6210\u3002\u65E5\u672C\u8A9E\u3068\u7E41\u4F53\u5B57\u4E2D\u56FD\u8A9E\u306F\u4E0A\u8A182\u8A00\u8A9E\u3092\u57FA\u306BLLM\u7FFB\u8A33\u3002\r\n-
      **\u6CE8\u8A18**\uFF1A\u5143\u8A00\u8A9E\u306E\u30BD\u30FC\u30B9\u30B3\u30F3\u30C6\u30F3\u30C4\u3092\u4E0A\u90E8\u306B\u8868\u793A\u3057\u3001\u7FFB\u8A33\u3092\u4E0B\u90E8\u306B\u8A18\u8F09\u3002\r\n-
      **\u9577\u6587\u30B3\u30F3\u30C6\u30F3\u30C4**\uFF08\u30D8\u30EB\u30D7\u3001\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3001Steam\u30DA\u30FC\u30B8\u7B49\uFF09\uFF1A\u82F1\u8A9E\u7248\u306F\u624B\u4F5C\u696D\u3067\u4F5C\u6210\u3001\u4ED6\u8A00\u8A9E\u306F\u82F1\u8A9E\u7248\u304B\u3089LLM\u7FFB\u8A33\u3002\r\n-
      **\u52D5\u7684\u30B3\u30F3\u30C6\u30F3\u30C4**\uFF08\u30C0\u30E1\u30FC\u30B8\u52B9\u679C\u3001\u6226\u95D8\u30ED\u30B0\u7B49\uFF09\uFF1A\u672A\u5BFE\u5FDC\u3002\r\n\r\n##
      \u306A\u305C\u8266\u8239\u306F\u30C0\u30E1\u30FC\u30B8\u30DD\u30A4\u30F3\u30C8100%\u5230\u9054\u5F8C\u3082\u5373\u5EA7\u306B\u6C88\u6CA1\u3057\u306A\u3044\u306E\u304B\uFF1F\r\n\r\nSK5\u30B7\u30B9\u30C6\u30E0\u3067\u306F\u3001\u30C0\u30E1\u30FC\u30B8\u30DD\u30A4\u30F3\u30C8\uFF08DP\uFF09\u304C100%\u306B\u9054\u3057\u3066\u3082\u8266\u8239\u304C\u6C88\u6CA1\u3059\u308B\u3068\u306F\u9650\u308A\u307E\u305B\u3093\u3002\u8266\u8239\u306F100%DP\u3092\u5927\u304D\u304F\u8D85\u3048\u3066\u3082\u751F\u5B58\u53EF\u80FD\u306A\u4E00\u65B9\u3001\u6700\u521D\u306E\u4E00\u6483\u3067\u77AC\u6642\u306B\u6C88\u6CA1\u3059\u308B\u5834\u5408\u3082\u3042\u308A\u307E\u3059\u3002\r\n\r\nDP\u306F\u4E3B\u306B\u300C\u4E00\u822C\u640D\u5BB3\u52B9\u679C\u300D\u306E\u767A\u52D5\u3092\u4FC3\u3057\u3001\u3053\u308C\u304C\u8266\u8239\u306E\u6226\u95D8\u80FD\u529B\u3092\u5927\u5E45\u306B\u6E1B\u8870\u3055\u305B\u307E\u3059\u3002100%DP\u306F\u8266\u8239\u304C\u300C\u30DF\u30C3\u30B7\u30E7\u30F3\u30AD\u30EB\u300D\uFF08\u6226\u95D8\u4E0D\u80FD\uFF09\u72B6\u614B\u306B\u9665\u308B\u78BA\u7387\u304C\u6975\u3081\u3066\u9AD8\u304F\u306A\u3063\u305F\u3053\u3068\u3092\u793A\u3059\u6307\u6A19\u3067\u3059\u3002\r\n\r\n\u30E1\u30AB\u30CB\u30BA\u30E0\u4E0A\u3001100%DP\u306F\u4E00\u822C\u640D\u5BB3\u52B9\u679C\u306E\u5224\u5B9A\u304C\u505C\u6B62\u3059\u308B\u95BE\u5024\u3067\u3059\u3002\u3053\u308C\u3092\u8D85\u3048\u308B\u3068\u3001\u8FFD\u52A0\u306E\u4E00\u822C\u640D\u5BB3\u52B9\u679C\u304C\u767A\u751F\u3057\u306A\u304F\u306A\u308B\u305F\u3081\u3001\u3080\u3057\u308D\u8FFD\u52A0\u88AB\u5F3E\u3042\u305F\u308A\u306E\u6C88\u6CA1\u30EA\u30B9\u30AF\u304C\u76F8\u5BFE\u7684\u306B\u4F4E\u4E0B\u3057\u307E\u3059\uFF08\u6C34\u4E0A\u90E8\u5206\u306B\u65B0\u305F\u306A\u88AB\u5F3E\u304C\u3042\u3063\u3066\u3082\u3001\u81F4\u547D\u7684\u306A\u7206\u767A\u78BA\u7387\u304C\u300C\u4F7F\u3044\u679C\u305F\u3055\u308C\u305F\u300D\u72B6\u614B\u3068\u60F3\u50CF\u3057\u3066\u304F\u3060\u3055\u3044\uFF09\u3002\u305F\u3060\u3057\u901A\u5E38\u653B\u6483\u306B\u3088\u308B\u7279\u5B9A\u306E\u640D\u5BB3\u52B9\u679C\u3067\u6C88\u6CA1\u3059\u308B\u53EF\u80FD\u6027\u306F\u6B8B\u308A\u307E\u3059\u3002\r\n\r\n##
      \u79FB\u52D5AI\u3092\u6709\u52B9\u306B\u3059\u308B\u65B9\u6CD5\r\n\r\nOOB\u30A8\u30C7\u30A3\u30BF\u30FC\u3067\u30B0\u30EB\u30FC\u30D7\u3092\u9078\u629E\u3057\u3001\u81EA\u52D5\u79FB\u52D5\u30D5\u30A3\u30FC\u30EB\u30C9\u3067\u300C\u7D99\u627F\u300D\u3092\u30AA\u30D5\u306B\u3057\u3066\u300C\u81EA\u52D5\u300D\u306B\u8A2D\u5B9A\u3057\u307E\u3059\u3002\u3059\u308B\u3068\u3001\u30B0\u30EB\u30FC\u30D7\u306F\u7279\u5B9A\u306E\u539F\u5247\u306B\u5F93\u3063\u3066\u9032\u8DEF\u3092\u5909\u66F4\u3057\u307E\u3059\u3002\u3053\u306E\u8A2D\u5B9A\u306F\u901A\u5E38\u3001\u300C\u65E5\u672C\u8266\u968A\u300D\u3084\u300C\u4E2D\u56FD\u8266\u968A\u300D\u306A\u3069\u306E\u6700\u4E0A\u4F4D\u30B0\u30EB\u30FC\u30D7\u306B\u9069\u7528\u3055\u308C\u307E\u3059\u304C\u3001\u4E00\u90E8\u3092\u81EA\u52D5\u5316\u3059\u308B\u305F\u3081\u306B\u4E0B\u4F4D\u30EC\u30D9\u30EB\u3067\u8A2D\u5B9A\u3059\u308B\u3053\u3068\u3082\u3067\u304D\u307E\u3059\u3002\r\n\r\nAI\u306F\u307E\u3060\u30D7\u30ED\u30C8\u30BF\u30A4\u30D7\u6BB5\u968E\u306B\u3042\u308B\u305F\u3081\uFF08\u4F8B\u3048\u3070\u3001\u9032\u8DEF\u3092\u8A08\u753B\u3057\u307E\u3059\u304C\u901F\u5EA6\u306F\u5909\u66F4\u3057\u307E\u305B\u3093\uFF09\u3001\u30C7\u30D5\u30A9\u30EB\u30C8\u3067\u306F\u6709\u52B9\u306B\u306A\u3063\u3066\u3044\u307E\u305B\u3093\u3002\u73FE\u5728\u3001\u30B2\u30FC\u30E0\u306F\u30B5\u30F3\u30C9\u30DC\u30C3\u30AF\u30B9\u30B9\u30BF\u30A4\u30EB\u306E\u30B2\u30FC\u30E0\u30D7\u30EC\u30A4\u3092\u63A8\u5968\u3057\u3066\u304A\u308A\u3001\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u4E21\u5074\u3092\u540C\u6642\u306B\u5236\u5FA1\u3057\u3001\u7D50\u679C\u3092\u89B3\u5BDF\u3057\u307E\u3059\u3002\u3053\u308C\u306F\u3001\u30BD\u30EA\u30C6\u30FC\u30EB\u306E\u30A6\u30A9\u30FC\u30B2\u30FC\u30DE\u30FC\u304C\u30DF\u30CB\u30C1\u30E5\u30A2\u3092\u4F7F\u3063\u3066\u904A\u3076\u65B9\u6CD5\u306B\u4F3C\u3066\u3044\u307E\u3059\u304C\u3001\u30B3\u30F3\u30D4\u30E5\u30FC\u30BF\u30FC\u306B\u3088\u308B\u81EA\u52D5\u89E3\u6C7A\u6A5F\u80FD\u306E\u52A9\u3051\u3092\u501F\u308A\u3066\u3044\u307E\u3059\u3002\r\n\r\n##
      \u7DE8\u96C6\u306F\u76F4\u611F\u7684\u3067\u306F\u306A\u3044\r\n\r\n\u5927\u898F\u6A21\u306A\u6539\u8A02\u304C\u4E88\u5B9A\u3055\u308C\u3066\u3044\u308B\u305F\u3081\u3001\u95A2\u9023\u3059\u308B\u8CC7\u6599\u3092\u307E\u3060\u66F8\u3044\u3066\u3044\u307E\u305B\u3093\u3002\u4F55\u304B\u3092\u7DE8\u96C6\u3057\u305F\u3044\u3068\u8003\u3048\u3066\u304A\u308A\u3001\u305D\u308C\u306B\u30A4\u30E9\u30A4\u30E9\u3057\u3066\u3044\u308B\u5834\u5408\u306F\u3001\u79C1\u306B\u9023\u7D61\u3057\u3066\u304F\u3060\u3055\u3044\uFF08GitHub\u30A4\u30B7\u30E5\u30FC\u307E\u305F\u306FDiscord\u30B5\u30FC\u30D0\u30FC\u7D4C\u7531\uFF09\u3002\u8AB0\u304B\u304C\u672C\u5F53\u306B\u8208\u5473\u3092\u6301\u3063\u3066\u3044\u308B\u3053\u3068\u3092\u77E5\u3089\u305B\u3066\u3082\u3089\u3048\u308C\u3070\u3001\u73FE\u6BB5\u968E\u3067\u306E\u64CD\u4F5C\u65B9\u6CD5\u3092\u8AAC\u660E\u3059\u308B\u4E00\u6642\u7684\u306A\u6587\u66F8\u3092\u4F5C\u6210\u3057\u307E\u3059\u3002\r\n\r\n##
      \u6A19\u6E96UI\u8981\u7D20\u306E\u591A\u304F\u304C\u300C\u30A8\u30C7\u30A3\u30BF\u300D\u3068\u547D\u540D\u3055\u308C\u3066\u3044\u308B\u7406\u7531\u306F\uFF1F
      \u7DE8\u96C6\u3067\u306F\u306A\u304F\u30D7\u30EC\u30A4\u3057\u305F\u3044\u306E\u3067\u3059\u304C\r\n\r\nVassal\u3084Tabletop
      Simulator\uFF08TTS\uFF09\u306E\u3088\u3046\u306A\u30B5\u30F3\u30C9\u30DC\u30C3\u30AF\u30B9\u4F53\u9A13\u3092\u518D\u73FE\u3059\u308B\u305F\u3081\u3067\u3059\u3002\u3053\u308C\u3089\u3067\u306F\u7DE8\u96C6\u6A5F\u80FD\u306B\u3088\u308A\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u30B3\u30FC\u30C7\u30A3\u30F3\u30B0\u306A\u3057\u3067\u72EC\u81EA\u30EB\u30FC\u30EB\u3092\u5C0E\u5165\u3067\u304D\u307E\u3059\u3002\u307E\u305FCommand:
      Modern Operations\uFF08CMO\uFF09\u306E\u3088\u3046\u306B\u7DE8\u96C6\u30E2\u30FC\u30C9\u3067\u5B9F\u9A13\u3092\u52B9\u7387\u5316\u3059\u308B\u6A5F\u80FD\u3082\u3001\u30B2\u30FC\u30E0\u306B\u7D44\u307F\u8FBC\u307F\u305F\u3044\u8981\u7D20\u3067\u3059\u3002\r\n\r\n##
      \u306A\u305C\u591A\u304F\u306E\u753B\u50CF\u3092\u30E9\u30F3\u30BF\u30A4\u30E0\u3067\u8AAD\u307F\u8FBC\u3080\u306E\u304B\uFF1F\r\n\r\nTabletop
      Simulator\u306E\u3088\u3046\u306B\u3001\u30B2\u30FC\u30E0\u30D7\u30EC\u30A4\u4E2D\u306B\u753B\u50CF\u3092\u52D5\u7684\u306B\u8AAD\u307F\u8FBC\u3080\u65B9\u5F0F\u3092\u63A1\u7528\u3059\u308B\u305F\u3081\u3067\u3059\u3002\r\n\r\n##
      \u30DF\u30CB\u30DE\u30EB\u30B0\u30E9\u30D5\u30A3\u30C3\u30AF\u306A\u306E\u306B\u30B2\u30FC\u30E0\u5BB9\u91CF\u304C\u5927\u304D\u3044\u7406\u7531\u306F\uFF1F
      RTW\u306E\u3088\u3046\u306A\u30DF\u30CB\u30B2\u30FC\u30E0\u3067\u306F\u306A\u3044\u306E\u304B\uFF1F\r\n\r\nCMO\u7B49\u3068\u540C\u69D8\u3001\u30A4\u30F3\u30B9\u30C8\u30FC\u30EB\u5BB9\u91CF\u306E\u5927\u90E8\u5206\u306FGIS\u6A19\u9AD8\u30C7\u30FC\u30BF\u304C\u5360\u3081\u307E\u3059\u3002Rule
      the Wave\u306A\u3069\u304C\u30D9\u30AF\u30BF\u30FC\u30C7\u30FC\u30BF\u4F7F\u7528\u3067\u5BB9\u91CF\u3092\u6291\u3048\u3066\u3044\u308B\u306E\u306B\u5BFE\u3057\u3001\u672C\u4F5C\u306F\u30E9\u30B9\u30BF\u30FC\u30C7\u30FC\u30BF\u3092\u63A1\u7528\uFF08\u6D77\u5E95\u30C7\u30FC\u30BF\u306F\u5727\u7E2E\u6E08\u307F\uFF09\u3002\r\n\r\n\u6A19\u9AD8\u30C7\u30FC\u30BF\u3092\u4FDD\u6301\u3059\u308B\u7406\u7531\u306F\u3001\u5C06\u6765\u5B9F\u88C5\u4E88\u5B9A\u306E\u9678\u4E0A\u6226\u8853\u6226\u95D8\u30B8\u30A7\u30CD\u30EC\u30FC\u30BF\u30FC\u3067\u5730\u5F62\u6A19\u9AD8\u3092\u6D3B\u7528\u3059\u308B\u305F\u3081\u3067\u3059\u3002\u307E\u305F\u6A19\u9AD8\u30C7\u30FC\u30BF\u306F\u4F4D\u7F6E\u8A8D\u8B58\u6027\u3068\u8996\u899A\u8868\u73FE\u306E\u5411\u4E0A\u306B\u3082\u5BC4\u4E0E\u3057\u307E\u3059\u3002\r\n\r\n##
      \u30B9\u30C8\u30E9\u30C6\u30B8\u30FC\u30B2\u30FC\u30E0\u306F\u73FE\u5728\u30D7\u30EC\u30A4\u53EF\u80FD\u304B\uFF1F\r\n\r\n\u3044\u3044\u3048\u3001\u73FE\u6642\u70B9\u3067\u30D7\u30EC\u30A4\u53EF\u80FD\u306A\u306E\u306F\u6D77\u6226\u30BF\u30AF\u30C6\u30A3\u30AB\u30EB\u30E2\u30FC\u30C9\u306E\u307F\uFF08\u3042\u308B\u7A0B\u5EA6\uFF09\u3002\u516C\u958B\u4E2D\u306E\u30B9\u30C8\u30E9\u30C6\u30B8\u30FC\u30B2\u30FC\u30E0\u30E2\u30FC\u30C9\u306F\u5B8C\u6210\u5F62\u306E\u4F53\u9A13\u3092*\u4F53\u611F\u3067\u304D\u308B*\u66AB\u5B9A\u7248\u3067\u3059\u3002\r\n\r\n\u73FE\u5728\u958B\u767A\u306E\u4E3B\u7126\u70B9\u304C\u30B9\u30C8\u30E9\u30C6\u30B8\u30FC\u30B2\u30FC\u30E0\u306B\u79FB\u3063\u3066\u3044\u308B\u305F\u3081\u3001\u30AA\u30FC\u30D7\u30F3\u30BD\u30FC\u30B9\u30B3\u30F3\u30C8\u30EA\u30D3\u30E5\u30FC\u30BF\u30FC\u306B\u3068\u3063\u3066\u306F\u7279\u306B\u6CE8\u76EE\u3059\u3079\u304D\u9818\u57DF\u3068\u8A00\u3048\u307E\u3059\u3002"
