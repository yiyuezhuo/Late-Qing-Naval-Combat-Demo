  - m_Id: 10965740016013312
    m_Localized: "\r\n## \u672C\u5730\u5316\u8D28\u91CF\u95EE\u9898\uFF1F\r\n\r\n\u5F00\u53D1\u8BED\u8A00\u57FA\u51C6\u662F\u82F1\u8BED\uFF0C\u8FD9\u662F\u6700\u5177\u6709\u53C2\u8003\u610F\u4E49\u7684\u7248\u672C\u3002\u5982\u679C\u60A8\u5728\u5176\u4ED6\u8BED\u8A00\u7248\u672C\u4E2D\u9047\u5230\u5B58\u7591\u7684\u7FFB\u8BD1\uFF0C\u8BF7\u4F18\u5148\u53C2\u7167\u82F1\u8BED\u7248\u672C\u8FDB\u884C\u6838\u5B9E\u3002\r\n\r\n\u5F53\u524D\u672C\u5730\u5316\u65B9\u6848\uFF1A\r\n\r\n-
      **\u57FA\u7840UI**\uFF1A\u82F1\u8BED\u4E0E\u7B80\u4F53\u4E2D\u6587\u7248\u672C\u4E3A\u624B\u5DE5\u7F16\u5199\u3002\u65E5\u8BED\u548C\u7E41\u4F53\u4E2D\u6587\u57FA\u4E8E\u524D\u4E24\u79CD\u8BED\u8A00\u7531LLM\u8F6C\u8BD1\u3002\r\n-
      **\u9644\u6CE8**\uFF1A\u9876\u90E8\u653E\u539F\u59CB\u6750\u6599\uFF08\u6E90\u8BED\u8A00\uFF09\uFF0C\u8BD1\u6587\u7F6E\u4E8E\u4E0B\u65B9\u3002\r\n-
      **\u957F\u6587\u672C**\uFF08\u5E2E\u52A9\u6587\u6863\u3001\u6559\u7A0B\u3001Steam\u9875\u9762\u3001FAQ\u7B49\uFF09\uFF1A\u82F1\u8BED\u7248\u672C\u4E3A\u4EBA\u5DE5\u64B0\u5199\uFF0C\u5176\u4ED6\u8BED\u8A00\u5747\u7531\u82F1\u8BED\u7248\u672C\u7ECFLLM\u8F6C\u8BD1\u3002\r\n-
      **\u52A8\u6001\u5185\u5BB9**\uFF08\u635F\u4F24\u7279\u6548\u3001\u6218\u6597\u65E5\u5FD7\u7B49\uFF09\uFF1A\u5C1A\u672A\u672C\u5730\u5316\u3002\r\n\r\n##
      \u4E3A\u4F55\u8230\u8239\u8FBE\u5230100%\u635F\u4F24\u503C\u540E\u4E0D\u4F1A\u7ACB\u5373\u6C89\u6CA1\uFF1F\r\n\r\n\u5728SK5\u7CFB\u7EDF\u4E2D\uFF0C\u8FBE\u5230100%\u635F\u4F24\u503C\uFF08DP\uFF09\u5E76\u4E0D\u4FDD\u8BC1\u8230\u8239\u4F1A\u6C89\u6CA1\u3002\u8239\u8236\u53EF\u80FD\u8FDC\u8D85\u8FC7100%DP\u4ECD\u5B58\u6D3B\u2014\u2014\u4E5F\u53EF\u80FD\u88AB\u9996\u6B21\u547D\u4E2D\u5373\u77AC\u95F4\u6C89\u6CA1\u3002\r\n\r\nDP\u4E3B\u8981\u9A71\u52A8\u901A\u7528\u635F\u4F24\u6548\u679C\u7684\u751F\u6210\uFF0C\u8FD9\u4E9B\u6548\u679C\u4F1A\u4E25\u91CD\u524A\u5F31\u8230\u8239\u4F5C\u6218\u80FD\u529B\u3002100%DP\u610F\u5473\u7740\u8230\u8239\u6781\u6709\u201C\u53EF\u80FD\u201D\u9677\u5165\u4EFB\u52A1\u6027\u5931\u80FD\uFF08\u6218\u6597\u6548\u80FD\u4E27\u5931\uFF09\u3002\r\n\r\n\u4ECE\u673A\u5236\u4E0A\u6765\u8BF4\uFF0CDP
      \u8FBE\u5230 100% \u65F6\u5373\u4E3A\u901A\u7528\u635F\u4F24\u6548\u679C\u68C0\u5B9A\u505C\u6B62\u7684\u9608\u503C\u3002\u8D85\u8FC7\u8BE5\u9608\u503C\u540E\uFF0C\u5C06\u4E0D\u518D\u8FDB\u884C\u989D\u5916\u7684\u68C0\u5B9A\uFF0C\u56E0\u6B64\u968F\u7740\u8FDB\u4E00\u6B65\u627F\u53D7\u4F24\u5BB3\uFF0C\u8230\u8247\u56E0\u901A\u7528\u635F\u4F24\u800C\u6C89\u6CA1\u7684\u76F8\u5BF9\u6982\u7387\u4F1A\u964D\u4F4E\uFF08\u53EF\u4EE5\u7406\u89E3\u4E3A\u7C7B\u4F3C\u5F39\u836F\u5E93\u7206\u70B8\u8FD9\u6837\u7684\u81F4\u547D\u6027\u7206\u70B8\u6982\u7387\u5DF2\u7ECF\u88AB\u201C\u6D88\u8017\u6B86\u5C3D\u201D\uFF0C\u6C34\u7EBF\u4E0A\u65B9\u518D\u589E\u52A0\u70AE\u5F39\u7834\u5B54\u4E5F\u4E0D\u4F1A\u8FDB\u4E00\u6B65\u63D0\u9AD8\u6C89\u6CA1\u7684\u53EF\u80FD\u6027\uFF09\u3002\r\n\u4E0D\u8FC7\uFF0C\u666E\u901A\u547D\u4E2D\u6240\u5F15\u53D1\u7684\u7279\u5B9A\u635F\u4F24\u6548\u679C\u4ECD\u7136\u53EF\u80FD\u5BFC\u81F4\u8230\u8247\u6C89\u6CA1\u3002\r\n\r\n##
      \u5982\u4F55\u542F\u7528\u79FB\u52A8AI\r\n\r\n\u5728OOB\u7F16\u8F91\u5668\u4E2D\u9009\u62E9\u4E00\u4E2A\u7FA4\u7EC4\uFF0C\u5728\u81EA\u52A8\u79FB\u52A8\u5B57\u6BB5\u4E2D\u5173\u95ED\u201C\u7EE7\u627F\u201D\uFF0C\u5E76\u5C06\u5176\u8BBE\u7F6E\u4E3A\u201C\u81EA\u52A8\u201D\u3002\u968F\u540E\uFF0C\u8BE5\u7FA4\u7EC4\u5C06\u6839\u636E\u7279\u5B9A\u539F\u5219\u6539\u53D8\u5176\u822A\u7EBF\u3002\u6B64\u8BBE\u7F6E\u901A\u5E38\u5E94\u7528\u4E8E\u9876\u7EA7\u7FA4\u7EC4\uFF0C\u4F8B\u5982\u201C\u65E5\u672C\u8230\u961F\u201D\u6216\u201C\u4E2D\u56FD\u8230\u961F\u201D\uFF0C\u4F46\u4E5F\u53EF\u5728\u4E0B\u5C5E\u7EA7\u522B\u8FDB\u884C\u8BBE\u7F6E\u4EE5\u5B9E\u73B0\u90E8\u5206\u81EA\u52A8\u5316\u3002\r\n\r\n##
      \u7F16\u8F91\u64CD\u4F5C\u4E0D\u76F4\u89C2\r\n\r\n\u7531\u4E8E\u9884\u8BA1\u4F1A\u6709\u91CD\u5927\u6539\u52A8\uFF0C\u6211\u5C1A\u672A\u7F16\u5199\u76F8\u5173\u6750\u6599\u3002\u5982\u679C\u60A8\u786E\u5B9E\u60F3\u8981\u7F16\u8F91\u67D0\u4E9B\u5185\u5BB9\u5E76\u611F\u5230\u56F0\u6270\uFF0C\u8BF7\u8054\u7CFB\u6211\uFF08\u901A\u8FC7GitHub
      issue\u6216Discord\uFF09\uFF0C\u8BA9\u6211\u77E5\u9053\u6709\u4EBA\u5BF9\u6B64\u771F\u6B63\u611F\u5174\u8DA3\uFF0C\u6211\u4F1A\u64B0\u5199\u4E34\u65F6\u6587\u6863\u6765\u8BF4\u660E\u5728\u5F53\u524D\u9636\u6BB5\u5982\u4F55\u64CD\u4F5C\u3002\r\n\r\n##
      \u4E3A\u4F55\u5927\u91CF\u6807\u51C6UI\u5143\u7D20\u90FD\u547D\u540D\u4E3A\"\u7F16\u8F91\u5668\"\uFF1F\u6211\u5E76\u4E0D\u60F3\"\u7F16\u8F91\"\u4EFB\u4F55\u5185\u5BB9\u2014\u2014\u53EA\u60F3\u6E38\u73A9\u3002\r\n\r\n\u6211\u7684\u76EE\u6807\u662F\u590D\u73B0\u7C7B\u4F3CVassal\u548CTabletop
      Simulator\uFF08TTS\uFF09\u7684\u6C99\u76D2\u4F53\u9A8C\uFF0C\u901A\u8FC7\u7F16\u8F91\u529F\u80FD\u8BA9\u73A9\u5BB6\u65E0\u9700\u7F16\u7801\u5373\u53EF\u5F15\u5165\u81EA\u5B9A\u4E49\u89C4\u5219\u4E0E\u623F\u89C4\u3002\u53E6\u4E00\u65B9\u9762\uFF0C\u5728
      CMO \u7B49\u6E38\u620F\u4E2D\uFF0C\u73A9\u5BB6\u5E38\u4F7F\u7528\u7F16\u8F91\u6A21\u5F0F\u5FEB\u901F\u8FDB\u884C\u5B9E\u9A8C\u2014\u2014\u8FD9\u6B63\u662F\u6211\u60F3\u8981\u878D\u5165\u6E38\u620F\u7684\u7279\u6027\u3002\r\n\r\n##
      \u4E3A\u4F55\u5927\u91CF\u56FE\u50CF\u91C7\u7528\u8FD0\u884C\u65F6\u52A0\u8F7D\uFF1F\r\n\r\n\u6211\u5E0C\u671B\u6548\u4EFFTabletop
      Simulator\u7684\u52A8\u6001\u56FE\u50CF\u52A0\u8F7D\u6A21\u5F0F\uFF0C\u5728\u6E38\u620F\u8FC7\u7A0B\u4E2D\u5B9E\u65F6\u8F7D\u5165\u56FE\u50CF\u8D44\u6E90\u3002\r\n\r\n##
      \u6E38\u620F\u4F53\u79EF\u4E3A\u4F55\u5982\u6B64\u5E9E\u5927\uFF1F\u91C7\u7528\"\u6781\u7B80\"\u753B\u98CE\u96BE\u9053\u4E0D\u8BE5\u662F\u50CF
      RTW \u90A3\u6837\u7684\u201C\u5C0F\u6E38\u620F\u201D\u5417\uFF1F\r\n\r\n\u4E0E
      CMO \u7B49\u6E38\u620F\u7C7B\u4F3C\uFF0C\u5B89\u88C5\u5305\u4F53\u79EF\u4E3B\u8981\u6765\u81EA
      GIS \u9AD8\u7A0B\u6570\u636E\u3002RTW \u7B49\u4F5C\u54C1\u901A\u8FC7\u4F7F\u7528\u77E2\u91CF\u6570\u636E\u89C4\u907F\u4E86\u8FD9\u7C7B\u5F00\u9500\uFF0C\u672C\u9879\u76EE\u4ECD\u91C7\u7528\u6805\u683C\u6570\u636E\u2014\u2014\u5373\u4FBF\u5DF2\u5BF9\u6D77\u6D0B\u6DF1\u5EA6\u6570\u636E\u8FDB\u884C\u622A\u65AD\u3002\r\n\r\n\u4FDD\u7559\u9AD8\u7A0B\u6570\u636E\u662F\u4E3A\u4E86\u652F\u6301\u89C4\u5212\u4E2D\u7684\u6218\u672F\u9646\u6218\u751F\u6210\u5668\uFF0C\u8BE5\u529F\u80FD\u5C06\u5728\u672A\u6765\u66F4\u65B0\u4E2D\u5229\u7528\u5730\u5F62\u9AD8\u7A0B\u3002\u540C\u65F6\u9AD8\u7A0B\u6570\u636E\u4E5F\u80FD\u8BA9\u5730\u7406\u4F4D\u7F6E\u663E\u793A\u66F4\u5177\u8FA8\u8BC6\u5EA6\u4E0E\u7F8E\u89C2\u6027\u3002\r\n\r\n##
      \u6218\u7565\u6E38\u620F\u6A21\u5F0F\u5F53\u524D\u53EF\u5426\u53EF\u73A9\uFF1F\r\n\r\n\u5C1A\u4E0D\u53EF\u73A9\uFF0C\u76EE\u524D\u4EC5\u6D77\u6218\u6218\u672F\u6A21\u5F0F\u5177\u5907\uFF08\u90E8\u5206\uFF09\u53EF\u73A9\u6027\u3002\u5DF2\u516C\u5F00\u7684\u6218\u7565\u6E38\u620F\u6A21\u5F0F\u4EC5\u7528\u4E8E\u8BA9\u73A9\u5BB6\u521D\u6B65\u4F53\u9A8C\u5B8C\u6574\u6218\u7565\u73A9\u6CD5\u7684*\u96CF\u5F62*\u3002\r\n\r\n\u8BE5\u90E8\u5206\u53EF\u80FD\u4E5F\u5BF9\u6F5C\u5728\u7684\u5F00\u6E90\u8D21\u732E\u8005\u6709\u76CA\uFF0C\u56E0\u4E3A\u6218\u7565\u6A21\u5F0F\u6B63\u5728\u79EF\u6781\u5F00\u53D1\u4E2D\u3002\r\n"
    m_Metadata:
      m_Items: []
