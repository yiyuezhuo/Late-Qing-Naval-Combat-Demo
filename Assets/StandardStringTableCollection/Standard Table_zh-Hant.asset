  - m_Id: 10965740016013312
    m_Localized: "\r\n## \u672C\u5730\u5316\u54C1\u8CEA\u554F\u984C\uFF1F\r\n\r\n\u958B\u767C\u8A9E\u8A00\u57FA\u790E\u662F\u82F1\u8A9E\uFF0C\u9019\u662F\u6700\u5B8C\u5584\u7684\u7248\u672C\u3002\u5982\u679C\u60A8\u5728\u5176\u4ED6\u8A9E\u8A00\u7248\u672C\u4E2D\u9047\u5230\u5B58\u7591\u7684\u7FFB\u8B6F\uFF0C\u8ACB\u512A\u5148\u53C3\u7167\u82F1\u8A9E\u7248\u672C\u9032\u884C\u6838\u5BE6\u3002\r\n\r\n\u7576\u524D\u672C\u5730\u5316\u65B9\u6848\uFF1A\r\n\r\n-
      **\u57FA\u790EUI**\uFF1A\u82F1\u8A9E\u8207\u7C21\u9AD4\u4E2D\u6587\u7248\u672C\u70BA\u624B\u5DE5\u6253\u9020\u3002\u65E5\u8A9E\u548C\u7E41\u9AD4\u4E2D\u6587\u57FA\u65BC\u524D\u5169\u7A2E\u8A9E\u8A00\u7531\u5927\u8A9E\u8A00\u6A21\u578B\u8F49\u8B6F\u3002\r\n-
      **\u8A3B\u91CB\u898F\u7BC4**\uFF1A\u9802\u90E8\u5448\u73FE\u6E90\u8A9E\u8A00\u5167\u5BB9\uFF0C\u8B6F\u6587\u7F6E\u65BC\u4E0B\u65B9\u3002\r\n-
      **\u9577\u6587\u672C**\uFF08\u8AAA\u660E\u6587\u4EF6\u3001\u6559\u5B78\u3001Steam\u9801\u9762\u7B49\uFF09\uFF1A\u82F1\u8A9E\u7248\u672C\u70BA\u4EBA\u5DE5\u64B0\u5BEB\uFF0C\u5176\u4ED6\u8A9E\u8A00\u5747\u7531\u82F1\u8A9E\u7248\u672C\u7D93\u5927\u8A9E\u8A00\u6A21\u578B\u8F49\u8B6F\u3002\r\n-
      **\u52D5\u614B\u5167\u5BB9**\uFF08\u640D\u50B7\u7279\u6548\u3001\u6230\u9B25\u7D00\u9304\u7B49\uFF09\uFF1A\u5C1A\u672A\u672C\u5730\u5316\u3002\r\n\r\n##
      \u70BA\u4F55\u8266\u8239\u9054\u5230100%\u640D\u50B7\u503C\u5F8C\u4E0D\u6703\u7ACB\u5373\u6C89\u6C92\uFF1F\r\n\r\n\u5728SK5\u7CFB\u7D71\u4E2D\uFF0C\u9054\u5230100%\u640D\u50B7\u503C\uFF08DP\uFF09\u4E26\u4E0D\u4FDD\u8B49\u8266\u8239\u6703\u6C89\u6C92\u3002\u8239\u8236\u53EF\u80FD\u9060\u8D85\u904E100%DP\u4ECD\u5B58\u6D3B\u2014\u2014\u4E5F\u53EF\u80FD\u88AB\u9996\u6B21\u547D\u4E2D\u5373\u77AC\u9593\u6C89\u6C92\u3002\r\n\r\nDP\u4E3B\u8981\u9A45\u52D5\u901A\u7528\u640D\u50B7\u6548\u679C\u7684\u751F\u6210\uFF0C\u9019\u4E9B\u6548\u679C\u6703\u56B4\u91CD\u524A\u5F31\u8266\u8239\u4F5C\u6230\u80FD\u529B\u3002100%DP\u6A19\u8A18\u610F\u5473\u8457\u8266\u8239\u6975\u6709\u53EF\u80FD\u9677\u5165\u4EFB\u52D9\u6027\u5931\u80FD\uFF08\u6230\u9B25\u6548\u80FD\u55AA\u5931\uFF09\u3002\r\n\r\n\u5728\u6A5F\u5236\u4E0A\uFF0C\u7576
      DP \u9054\u5230 100% \u6642\uFF0C\u5373\u70BA\u901A\u7528\u640D\u50B7\u6548\u679C\u6AA2\u5B9A\u505C\u6B62\u7684\u81E8\u754C\u9EDE\u3002\u8D85\u904E\u6B64\u6578\u503C\u5F8C\uFF0C\u5C07\u4E0D\u518D\u9032\u884C\u984D\u5916\u7684\u6AA2\u5B9A\uFF0C\u56E0\u6B64\u5373\u4F7F\u627F\u53D7\u66F4\u591A\u50B7\u5BB3\uFF0C\u8266\u8247\u56E0\u901A\u7528\u640D\u50B7\u800C\u6C89\u6C92\u7684\u76F8\u5C0D\u6A5F\u7387\u6703\u964D\u4F4E\uFF08\u53EF\u7406\u89E3\u70BA\u5982\u5F48\u85E5\u5EAB\u7206\u70B8\u822C\u7684\u81F4\u547D\u6027\u7206\u70B8\u6A5F\u7387\u5DF2\u88AB\u300C\u6D88\u8017\u6B86\u76E1\u300D\uFF0C\u6C34\u7DDA\u4EE5\u4E0A\u518D\u589E\u52A0\u5F48\u5B54\u4E5F\u4E0D\u6703\u9032\u4E00\u6B65\u63D0\u9AD8\u6C89\u6C92\u7684\u53EF\u80FD\u6027\uFF09\u3002\r\n\u4E0D\u904E\uFF0C\u7531\u4E00\u822C\u547D\u4E2D\u6240\u9020\u6210\u7684\u7279\u5B9A\u640D\u50B7\u6548\u679C\uFF0C\u4ECD\u7136\u53EF\u80FD\u5C0E\u81F4\u8266\u8247\u6C89\u6C92\u3002\r\n\r\n##
      \u5982\u4F55\u555F\u7528\u79FB\u52D5AI\r\n\r\n\u5728OOB\u7DE8\u8F2F\u5668\u4E2D\u9078\u64C7\u4E00\u500B\u7FA4\u7D44\uFF0C\u5728\u81EA\u52D5\u79FB\u52D5\u6B04\u4F4D\u4E2D\u95DC\u9589\u300C\u7E7C\u627F\u300D\uFF0C\u4E26\u5C07\u5176\u8A2D\u5B9A\u70BA\u300C\u81EA\u52D5\u300D\u3002\u96A8\u5F8C\uFF0C\u8A72\u7FA4\u7D44\u5C07\u6839\u64DA\u7279\u5B9A\u539F\u5247\u6539\u8B8A\u5176\u822A\u7DDA\u3002\u6B64\u8A2D\u5B9A\u901A\u5E38\u61C9\u7528\u65BC\u9802\u7D1A\u7FA4\u7D44\uFF0C\u4F8B\u5982\u300C\u65E5\u672C\u8266\u968A\u300D\u6216\u300C\u4E2D\u570B\u8266\u968A\u300D\uFF0C\u4F46\u4E5F\u53EF\u5728\u4E0B\u5C6C\u7D1A\u5225\u9032\u884C\u8A2D\u5B9A\u4EE5\u5BE6\u73FE\u90E8\u5206\u81EA\u52D5\u5316\u3002\r\n\r\n##
      \u7DE8\u8F2F\u64CD\u4F5C\u4E0D\u76F4\u89C0\r\n\r\n\u7531\u65BC\u9810\u8A08\u6703\u6709\u91CD\u5927\u6539\u52D5\uFF0C\u6211\u5C1A\u672A\u7DE8\u5BEB\u76F8\u95DC\u6750\u6599\u3002\u5982\u679C\u60A8\u78BA\u5BE6\u60F3\u8981\u7DE8\u8F2F\u67D0\u4E9B\u5167\u5BB9\u4E26\u611F\u5230\u56F0\u64FE\uFF0C\u8ACB\u806F\u7E6B\u6211\uFF08\u900F\u904EGitHub
      issue\u6216Discord\u4F3A\u670D\u5668\uFF09\uFF0C\u8B93\u6211\u77E5\u9053\u6709\u4EBA\u5C0D\u6B64\u771F\u6B63\u611F\u8208\u8DA3\uFF0C\u6211\u6703\u64B0\u5BEB\u81E8\u6642\u6587\u4EF6\u4F86\u8AAA\u660E\u5728\u76EE\u524D\u968E\u6BB5\u5982\u4F55\u64CD\u4F5C\u3002\r\n\r\n##
      \u70BA\u4F55\u5927\u91CF\u6A19\u6E96UI\u5143\u7D20\u90FD\u547D\u540D\u70BA\u300C\u7DE8\u8F2F\u5668\u300D\uFF1F\u6211\u4E26\u4E0D\u60F3\u300C\u7DE8\u8F2F\u300D\u4EFB\u4F55\u5167\u5BB9\u2014\u2014\u53EA\u60F3\u904A\u73A9\u3002\r\n\r\n\u6211\u7684\u76EE\u6A19\u662F\u91CD\u73FE\u985E\u4F3CVassal\u548CTabletop
      Simulator\uFF08TTS\uFF09\u7684\u6C99\u76D2\u9AD4\u9A57\uFF0C\u900F\u904E\u7DE8\u8F2F\u529F\u80FD\u8B93\u73A9\u5BB6\u7121\u9700\u7DE8\u78BC\u5373\u53EF\u5F15\u5165\u81EA\u8A02\u898F\u5247\u8207\u623F\u898F\u3002\u53E6\u4E00\u65B9\u9762\uFF0C\u5728\u300A\u6307\u63EE\uFF1A\u73FE\u4EE3\u884C\u52D5\u300B\uFF08CMO\uFF09\u7B49\u904A\u6232\u4E2D\uFF0C\u73A9\u5BB6\u5E38\u4F7F\u7528\u7DE8\u8F2F\u6A21\u5F0F\u5FEB\u901F\u9032\u884C\u5BE6\u9A57\u2014\u2014\u9019\u6B63\u662F\u6211\u60F3\u8981\u878D\u5165\u904A\u6232\u7684\u7279\u6027\u3002\r\n\r\n##
      \u70BA\u4F55\u5927\u91CF\u5716\u50CF\u63A1\u7528\u904B\u884C\u6642\u52A0\u8F09\uFF1F\r\n\r\n\u6211\u5E0C\u671B\u6548\u4EFFTabletop
      Simulator\u7684\u52D5\u614B\u5716\u50CF\u52A0\u8F09\u6A21\u5F0F\uFF0C\u5728\u904A\u6232\u904E\u7A0B\u4E2D\u5373\u6642\u8F09\u5165\u5716\u50CF\u8CC7\u6E90\u3002\r\n\r\n##
      \u904A\u6232\u9AD4\u7A4D\u70BA\u4F55\u5982\u6B64\u9F90\u5927\uFF1F\u63A1\u7528\u300C\u6975\u7C21\u300D\u756B\u98A8\u96E3\u9053\u4E0D\u8A72\u50CF\u300A\u7D71\u6CBB\u6CE2\u6D6A\u300B\u90A3\u6A23\u662F\u5C0F\u578B\u904A\u6232\u55CE\uFF1F\r\n\r\n\u8207\u300A\u6307\u63EE\uFF1A\u73FE\u4EE3\u884C\u52D5\u300B\u7B49\u904A\u6232\u985E\u4F3C\uFF0C\u5B89\u88DD\u5305\u9AD4\u7A4D\u4E3B\u8981\u4F86\u81EAGIS\u9AD8\u7A0B\u6578\u64DA\u3002\u96D6\u7136\u300A\u7D71\u6CBB\u6CE2\u6D6A\u300B\u7B49\u4F5C\u54C1\u900F\u904E\u4F7F\u7528\u5411\u91CF\u6578\u64DA\u898F\u907F\u4E86\u9019\u985E\u958B\u92B7\uFF0C\u672C\u5C08\u6848\u4ECD\u63A1\u7528\u67F5\u683C\u6578\u64DA\u2014\u2014\u5373\u4FBF\u5DF2\u5C0D\u6D77\u6D0B\u6DF1\u5EA6\u6578\u64DA\u9032\u884C\u58D3\u7E2E\u3002\r\n\r\n\u4FDD\u7559\u9AD8\u7A0B\u6578\u64DA\u662F\u70BA\u4E86\u652F\u63F4\u898F\u5283\u4E2D\u7684\u6230\u8853\u9678\u6230\u751F\u6210\u5668\uFF0C\u8A72\u529F\u80FD\u5C07\u5728\u672A\u4F86\u66F4\u65B0\u4E2D\u5229\u7528\u5730\u5F62\u9AD8\u7A0B\u3002\u540C\u6642\u9AD8\u7A0B\u6578\u64DA\u4E5F\u80FD\u8B93\u5730\u7406\u4F4D\u7F6E\u986F\u793A\u66F4\u5177\u8FA8\u8B58\u5EA6\u8207\u7F8E\u89C0\u6027\u3002\r\n\r\n##
      \u6230\u7565\u904A\u6232\u6A21\u5F0F\u7576\u524D\u53EF\u5426\u904A\u73A9\uFF1F\r\n\r\n\u5C1A\u4E0D\u53EF\u7528\uFF0C\u76EE\u524D\u50C5\u6D77\u6230\u6230\u8853\u6A21\u5F0F\u5177\u5099\uFF08\u90E8\u5206\uFF09\u53EF\u73A9\u6027\u3002\u5DF2\u516C\u958B\u7684\u6230\u7565\u904A\u6232\u6A21\u5F0F\u50C5\u7528\u65BC\u8B93\u73A9\u5BB6\u521D\u6B65\u9AD4\u9A57\u5B8C\u6574\u6230\u7565\u73A9\u6CD5\u7684*\u96DB\u5F62*\u3002\r\n\r\n\u8A72\u9818\u57DF\u53EF\u80FD\u5C0D\u958B\u6E90\u8CA2\u737B\u8005\u5177\u6709\u7279\u6B8A\u610F\u7FA9\uFF0C\u56E0\u70BA\u6230\u7565\u904A\u6232\u73FE\u5DF2\u6210\u70BA\u958B\u767C\u7684\u6838\u5FC3\u7126\u9EDE\u3002"
    m_Metadata:
      m_Items: []
