<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement class="panel-dialog" style="flex-grow: 0; width: 650px; height: auto;">
        <ui:Label text="About" name="TitleLabel" class="title"/>
        <ui:VisualElement style="flex-direction: row; column-gap: 16px; padding-top: 3px; padding-bottom: 3px; padding-left: 3px;">
            <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; flex-basis: 320px; min-width: 260px; row-gap: 10px;">
                <ui:Label text="First Sino-Japanese War" name="ProductNameLabel" style="font-size: 16px; -unity-font-style: bold;"/>
                <ui:Label text="Version: 0.0.0" name="VersionLabel"/>
                <ui:Label text="Developed by January Desk" name="DeveloperLabel"/>
                <ui:Label text="Open-source under the MIT License" name="LicenseLabel" style="white-space: normal;"/>
            </ui:VisualElement>
            <ui:ScrollView name="LinkScrollView" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" style="flex-grow: 1;">
                <ui:VisualElement style="flex-grow: 1; row-gap: 8px; padding-right: 4px;">
                    <ui:Button text="GitHub (Open Source Repository)" name="GitHubButton"/>
                    <ui:Button text="Online Manual" name="OnlineManualButton"/>
                    <ui:Button text="Steam Store" name="SteamStoreButton"/>
                    <ui:Button text="Steam Discussions" name="SteamDiscussionsButton"/>
                    <ui:Button text="Discord" name="DiscordButton"/>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:Button text="Confirm" name="ConfirmButton">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(66345015873536)"/>
            </Bindings>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
