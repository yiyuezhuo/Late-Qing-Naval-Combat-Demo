<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="FireControlSystemEditor" src="project://database/Assets/UIDocuments/NavalCombat/FireControlSystemEditor.uxml?fileID=9197481963319205126&amp;guid=c29461650190bff438b825e8531626e6&amp;type=3#FireControlSystemEditor"/>
    <ui:Template name="GlobalStringEditor" src="project://database/Assets/UIDocuments/Common/GlobalStringEditor.uxml?fileID=9197481963319205126&amp;guid=bbf36dc1793baa44a987432580e3d674&amp;type=3#GlobalStringEditor"/>
    <ui:VisualElement data-source-type="NavalCombatCore.BatteryRecord, Assembly-CSharp" style="flex-grow: 1;">
        <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
            <ui:VisualElement style="flex-grow: 1; flex-basis: 100px;">
                <ui:Instance template="GlobalStringEditor" data-source-path="name">
                    <AttributeOverrides element-name="GlobalStringLabel" text="Name"/>
                </ui:Instance>
                <ui:Toggle label="Has Fire Control Radar">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(45034289424404480)"/>
                        <ui:DataBinding property="value" data-source-path="hasFireControlRadar" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:Toggle>
                <ui:VisualElement>
                    <ui:FloatField label="FC Radar Modifier">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="fireControlRadarModifier" binding-mode="TwoWay"/>
                            <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(73607310643200)"/>
                        </Bindings>
                    </ui:FloatField>
                    <ui:Instance template="GlobalStringEditor" data-source-path="fireControlRadarName">
                        <AttributeOverrides element-name="GlobalStringLabel" text="Fire Control Radar Name"/>
                    </ui:Instance>
                    <Bindings>
                        <ui:DataBinding property="style.display" data-source-path="hasFireControlRadar" binding-mode="ToTarget" source-to-ui-converters="Bool to DisplayStyle"/>
                    </Bindings>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; flex-basis: 100px;">
                <ui:FloatField label="Range (Yards)">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="rangeYards" binding-mode="TwoWay"/>
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(73674033631232)"/>
                    </Bindings>
                </ui:FloatField>
                <ui:FloatField label="Max ROF">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="maxRateOfFireShootPerMin" binding-mode="TwoWay"/>
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(73929584185344)"/>
                    </Bindings>
                </ui:FloatField>
                <ui:FloatField label="Shell Size (Inch)">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="shellSizeInchProp" binding-mode="TwoWay"/>
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(74151416729600)"/>
                    </Bindings>
                </ui:FloatField>
                <ui:FloatField label="Shell Weight (pounds)">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="shellWeightPoundsProp" binding-mode="TwoWay"/>
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(74227052613632)"/>
                    </Bindings>
                </ui:FloatField>
                <ui:FloatField label="Damage Rating">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="damageRating" binding-mode="TwoWay"/>
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(73757923905536)"/>
                    </Bindings>
                </ui:FloatField>
                <ui:IntegerField label="Ammunition Capacity">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="ammunitionCapacity" binding-mode="TwoWay"/>
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(74290944446464)"/>
                    </Bindings>
                </ui:IntegerField>
                <ui:FloatField label="Rounds Per Gun" enabled="false">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(38132922621530112)"/>
                        <ui:DataBinding property="value" data-source-path="roundsPerGun" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:FloatField>
                <ui:IntegerField label="Fire Control Positions">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="fireControlPositions" binding-mode="TwoWay"/>
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(73982021373952)"/>
                    </Bindings>
                </ui:IntegerField>
                <ui:Instance template="FireControlSystemEditor" data-source-path="fireControlType"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="FireControlTableToolRow" style="flex-direction: row; flex-shrink: 0; margin-bottom: 4px;">
            <ui:Toggle label="Custom Fire Control Table" style="flex-shrink: 0; margin-right: 4px;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(-221)"/>
                    <ui:DataBinding property="value" data-source-path="customFireControlTable" binding-mode="TwoWay"/>
                </Bindings>
            </ui:Toggle>
            <ui:Button text="Model Comparison" name="FireControlModelComparisonButton" style="flex-shrink: 0;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(-106)"/>
                </Bindings>
            </ui:Button>
            <ui:Button text="Reset Fire Control Table" name="ResetFireControlTableButton" style="flex-shrink: 0; margin-left: 4px;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(-109)"/>
                </Bindings>
            </ui:Button>
            <ui:Button text="Reset Penetration Table" name="ResetPenetrationTableButton" style="flex-shrink: 0; margin-left: 4px;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(-107)"/>
                </Bindings>
            </ui:Button>
            <ui:Button text="Meta Info" name="BatteryRecordMetaInfoButton" style="flex-shrink: 0; margin-left: 4px; display: none;"/>
            <ui:Button text="Meta Info (McCoy Okun)" name="BatteryRecordMetaInfoMcCoyOkunButton" style="flex-shrink: 0; margin-left: 4px;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(-173)"/>
                </Bindings>
            </ui:Button>
        </ui:VisualElement>
        <ui:MultiColumnListView data-source-path="fireControlTableRecords" binding-source-selection-mode="AutoAssign" header-title="Fire Control Table" show-foldout-header="true" show-add-remove-footer="true" name="FireControlTableMultiColumnListView">
            <ui:Columns>
                <ui:Column name="targetSpeed" title="Tgt Spd" width="11%" cell-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordSpeedThreshold.uxml?fileID=9197481963319205126&amp;guid=f7187544acb99c54b9385828709cbf5f&amp;type=3#FireControlTableRecordSpeedThreshold" header-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordSpeedThresholdHeader.uxml?fileID=9197481963319205126&amp;guid=83325986dbd92c54b90693113ee53950&amp;type=3#FireControlTableRecordSpeedThresholdHeader"/>
                <ui:Column name="shortBroad" title="S/B" cell-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordShortBroad.uxml?fileID=9197481963319205126&amp;guid=fba5941f41a39eb408d05c3f7085dc86&amp;type=3#FireControlTableRecordShortBroad" width="11%" header-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordShortBroadHeader.uxml?fileID=9197481963319205126&amp;guid=a305a30890456254fb4deefc1514c671&amp;type=3#FireControlTableRecordShortBroadHeader"/>
                <ui:Column name="shortNarrow" title="S/N" cell-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordShortNarrow.uxml?fileID=9197481963319205126&amp;guid=ba6fd6229d64d96428f39beaa9f4cf22&amp;type=3#FireControlTableRecordShortNarrow" width="11%" header-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordShortNarrowHeader.uxml?fileID=9197481963319205126&amp;guid=3eb527051225cc244b3286af5ef67397&amp;type=3#FireControlTableRecordShortNarrowHeader"/>
                <ui:Column name="mediumBorad" title="M/B" cell-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordMediumBroad.uxml?fileID=9197481963319205126&amp;guid=3bd636258b844d64294396effe33d324&amp;type=3#FireControlTableRecordMediumBroad" width="11%" header-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordMediumBroadHeader.uxml?fileID=9197481963319205126&amp;guid=d294449b17ec1104c9ee9210aff0f0aa&amp;type=3#FireControlTableRecordMediumBroadHeader"/>
                <ui:Column name="mediumNarrow" title="M/N" cell-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordMediumNarrow.uxml?fileID=9197481963319205126&amp;guid=88d4602495d7e894d985afd0938033bc&amp;type=3#FireControlTableRecordMediumNarrow" width="11%" header-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordMediumNarrowHeader.uxml?fileID=9197481963319205126&amp;guid=aee8f04b5c6ea7a43be7e8bf79778c9f&amp;type=3#FireControlTableRecordMediumNarrowHeader"/>
                <ui:Column name="longBroad" title="L/B" cell-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordLongBroad.uxml?fileID=9197481963319205126&amp;guid=dea483fe7eef4aa4488e6775712ce818&amp;type=3#FireControlTableRecordLongBroad" width="11%" header-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordLongBroadHeader.uxml?fileID=9197481963319205126&amp;guid=c056f762284942c4f978d8ec8c7118d7&amp;type=3#FireControlTableRecordLongBroadHeader"/>
                <ui:Column name="longNarrow" title="L/N" cell-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordLongNarrow.uxml?fileID=9197481963319205126&amp;guid=075da859e0a57ed4e9778bb490172470&amp;type=3#FireControlTableRecordLongNarrow" width="11%" header-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordLongNarrowHeader.uxml?fileID=9197481963319205126&amp;guid=347123033cce59f40a03d040b6fc0fde&amp;type=3#FireControlTableRecordLongNarrowHeader"/>
                <ui:Column name="extremeBroad" title="E/B" cell-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordExtremeBroad.uxml?fileID=9197481963319205126&amp;guid=1bb41510ad8dcca4a9de0673efb78cfb&amp;type=3#FireControlTableRecordExtremeBroad" width="11%" header-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordExtremeBroadHeader.uxml?fileID=9197481963319205126&amp;guid=005a632a8ee4bc64daa3e7a42203ecbb&amp;type=3#FireControlTableRecordExtremeBroadHeader"/>
                <ui:Column name="extremeNarrow" title="E/N" cell-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordExtremeNarrow.uxml?fileID=9197481963319205126&amp;guid=3bc307bf85d3c594aace6ce31b6eb20f&amp;type=3#FireControlTableRecordExtremeNarrow" width="11%" header-template="project://database/Assets/UIDocuments/Templates/FireControlTableRecord/FireControlTableRecordExtremeNarrowHeader.uxml?fileID=9197481963319205126&amp;guid=b2ded5807d88b3d43adafedce7efc48a&amp;type=3#FireControlTableRecordExtremeNarrowHeader"/>
            </ui:Columns>
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="headerTitle" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(74394027855872)"/>
            </Bindings>
        </ui:MultiColumnListView>
        <LocalizedEnumField type-str="NavalCombatCore.AmmunitionType" label="Penetration Base Ammo">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(74500038889472)"/>
                <ui:DataBinding property="value" data-source-path="penetrationTableBaseType" source-to-ui-converters="AmmunitionType =&gt; int" ui-to-source-converters="int =&gt; AmmunitionType" binding-mode="TwoWay"/>
            </Bindings>
        </LocalizedEnumField>
        <ui:MultiColumnListView binding-source-selection-mode="AutoAssign" header-title="Penetration Table" show-add-remove-footer="true" show-foldout-header="true" name="PenetrationTableMultiColumnListView" data-source-path="penetrationTableRecords">
            <ui:Columns>
                <ui:Column name="distanceYards" title="Distance Yards" cell-template="project://database/Assets/UIDocuments/Templates/PenetrationTableRecord/PenetrationTableRecordDistanceYardsCell.uxml?fileID=9197481963319205126&amp;guid=cd1fda2a8714e5b43b7810a7b5bc29e6&amp;type=3#PenetrationTableRecordDistanceYardsCell" width="20%" header-template="project://database/Assets/UIDocuments/Templates/PenetrationTableRecord/PenetrationTableRecordDistanceYardsHeader.uxml?fileID=9197481963319205126&amp;guid=5f79f245f1866ad42a229b703cc02783&amp;type=3#PenetrationTableRecordDistanceYardsHeader"/>
                <ui:Column name="rateOfFire" title="Rate of Fire" cell-template="project://database/Assets/UIDocuments/Templates/PenetrationTableRecord/PenetrationTableRecordRateOfFireCell.uxml?fileID=9197481963319205126&amp;guid=e0fdbd9019b12644c986a0538165d8c4&amp;type=3#PenetrationTableRecordRateOfFireCell" width="20%" header-template="project://database/Assets/UIDocuments/Templates/PenetrationTableRecord/PenetrationTableRecordRateOfFireHeader.uxml?fileID=9197481963319205126&amp;guid=a9a41979be8bdff45aec662fe6cb7e77&amp;type=3#PenetrationTableRecordRateOfFireHeader"/>
                <ui:Column name="rangeBand" title="Range Band" cell-template="project://database/Assets/UIDocuments/Templates/PenetrationTableRecord/PenetrationTableRecordRangeBandCell.uxml?fileID=9197481963319205126&amp;guid=74e4e20435043c64fabb80c7663b2e5a&amp;type=3#PenetrationTableRecordRangeBandCell" width="20%" header-template="project://database/Assets/UIDocuments/Templates/PenetrationTableRecord/PenetrationTableRecordRangeBandHeader.uxml?fileID=9197481963319205126&amp;guid=065e6b3bdceb62e45ba0f3582d9aa1de&amp;type=3#PenetrationTableRecordRangeBandHeader"/>
                <ui:Column name="horizontalPenetrationInch" visible="true" title="Hor Pen" cell-template="project://database/Assets/UIDocuments/Templates/PenetrationTableRecord/PenetrationTableRecordHorizontalPenetrationCell.uxml?fileID=9197481963319205126&amp;guid=1addbdac246e8d14587dc33da2c292ec&amp;type=3#PenetrationTableRecordHorizontalPenetrationCell" width="20%" header-template="project://database/Assets/UIDocuments/Templates/PenetrationTableRecord/PenetrationTableRecordHorizontalPenetrationHeader.uxml?fileID=9197481963319205126&amp;guid=2b96b1dba6861144886ccb6cdf796859&amp;type=3#PenetrationTableRecordHorizontalPenetrationHeader"/>
                <ui:Column name="verticalPenetrationInch" title="Vert Pen" cell-template="project://database/Assets/UIDocuments/Templates/PenetrationTableRecord/PenetrationTableRecordVerticalPenetrationCell.uxml?fileID=9197481963319205126&amp;guid=5584ef34bfb3eac48938af85c4608e0a&amp;type=3#PenetrationTableRecordVerticalPenetrationCell" width="20%" header-template="project://database/Assets/UIDocuments/Templates/PenetrationTableRecord/PenetrationTableRecordVerticalPenetrationHeader.uxml?fileID=9197481963319205126&amp;guid=0e6b7b81b6c0d104c9a6790fe67be3b6&amp;type=3#PenetrationTableRecordVerticalPenetrationHeader"/>
            </ui:Columns>
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="headerTitle" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(74592103862272)"/>
            </Bindings>
        </ui:MultiColumnListView>
        <ui:ListView show-foldout-header="true" show-add-remove-footer="true" header-title="Mounts" binding-source-selection-mode="AutoAssign" item-template="project://database/Assets/UIDocuments/NavalCombat/MountLocationRecordEditor.uxml?fileID=9197481963319205126&amp;guid=83e697c363f8eb349b6713defb6ef393&amp;type=3#MountLocationRecordEditor" name="MountsListView" data-source-path="mountLocationRecords" virtualization-method="DynamicHeight">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="headerTitle" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(74786790871040)"/>
            </Bindings>
        </ui:ListView>
    </ui:VisualElement>
</ui:UXML>
