<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UIDocuments/styles/style.uss?fileID=7433441132597879392&amp;guid=2bc9a89e260078e449dd456da4bfcf64&amp;type=3#style"/>
    <ui:VisualElement data-source-type="NavalCombatCore.BatteryStatus, Assembly-CSharp" style="flex-grow: 1; flex-shrink: 0;">
        <ui:VisualElement style="flex-grow: 0; flex-direction: row; flex-shrink: 0;">
            <ui:Label text="battery record&apos;s merged name">
                <Bindings>
                    <ui:DataBinding property="text" binding-mode="ToTarget" source-to-ui-converters="BatteryStatus =&gt; BatteryStatus&apos;s BatteryRecord&apos;s Name"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 0; flex-shrink: 0;">
            <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; flex-direction: row;">
                <ui:Button text="Detail" name="BatteryDetailButton">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(102671505330176)"/>
                    </Bindings>
                </ui:Button>
                <ui:Label text="FCR Disabled">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(169182760701952)"/>
                    </Bindings>
                </ui:Label>
                <ui:Toggle>
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="fireControlRadarDisabled" binding-mode="TwoWay"/>
                        <ui:DataBinding property="enabledSelf" data-source-path="isInEditorMode" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Toggle>
                <ui:Label text="Capacity:">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(169093392666624)"/>
                    </Bindings>
                </ui:Label>
                <ui:Label>
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="batteryRecord.ammunitionCapacity" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement data-source-path="ammunition" style="flex-grow: 0;">
                <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
                    <ui:IntegerField label="AP" class="size50" style="flex-grow: 1; flex-basis: 50px;">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="ArmorPiercing" binding-mode="TwoWay"/>
                            <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(169342341386240)"/>
                        </Bindings>
                    </ui:IntegerField>
                    <ui:IntegerField label="SAP" class="size50" style="flex-basis: 50px; flex-grow: 1;">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="semiArmorPiercing" binding-mode="TwoWay"/>
                            <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(169446628560896)"/>
                        </Bindings>
                    </ui:IntegerField>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
                    <ui:IntegerField label="COM" class="size50" style="flex-basis: 50px; flex-grow: 1;">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="common" binding-mode="TwoWay"/>
                            <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(169509849305088)"/>
                        </Bindings>
                    </ui:IntegerField>
                    <ui:IntegerField label="HE" class="size50" style="flex-basis: 50px; flex-grow: 1;">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="highExplosive" binding-mode="TwoWay"/>
                            <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(169589046153216)"/>
                        </Bindings>
                    </ui:IntegerField>
                </ui:VisualElement>
                <Bindings>
                    <ui:DataBinding property="enabledSelf" data-source-path="isInEditMode" binding-mode="ToTarget"/>
                </Bindings>
            </ui:VisualElement>
            <ui:MultiColumnListView name="MountStatusMultiColumnListView" binding-source-selection-mode="AutoAssign" show-add-remove-footer="true" data-source-path="mountStatus" style="flex-shrink: 0;">
                <ui:Columns>
                    <ui:Column name="mountLocationRecordSummary" title="Info" width="20%" cell-template="project://database/Assets/UIDocuments/Templates/MountStatus/MountStatusCellMountLocationRecordSummary.uxml?fileID=9197481963319205126&amp;guid=a9d6744fd962fc3499fe76d34f17fbdc&amp;type=3#MountStatusCellMountLocationRecordSummary" header-template="project://database/Assets/UIDocuments/Templates/MountStatus/MountStatusHeaderMountLocationRecordSummary.uxml?fileID=9197481963319205126&amp;guid=d55fc68d1bcda5b44b29d16785edea61&amp;type=3#MountStatusHeaderMountLocationRecordSummary"/>
                    <ui:Column width="5%" title="B" cell-template="project://database/Assets/UIDocuments/Templates/AbstractMountStatus/AbstractMountStatusCellBarrels.uxml?fileID=9197481963319205126&amp;guid=005db7aa940754d469ff7e3345372567&amp;type=3#AbstractMountStatusCellBarrels" header-template="project://database/Assets/UIDocuments/Templates/AbstractMountStatus/AbstractMountStatusHeaderBarrels.uxml?fileID=9197481963319205126&amp;guid=2a15056f29c006e4998074f760bbcb27&amp;type=3#AbstractMountStatusHeaderBarrels"/>
                    <ui:Column name="status" title="Status" width="15%" cell-template="project://database/Assets/UIDocuments/Templates/AbstractMountStatus/AbstractMountStatusCellStatus.uxml?fileID=9197481963319205126&amp;guid=59c6fb856a1cee248a8d5aa1a0da437b&amp;type=3#AbstractMountStatusCellStatus" header-template="project://database/Assets/UIDocuments/Templates/AbstractMountStatus/AbstractMountStatusHeaderStatus.uxml?fileID=9197481963319205126&amp;guid=7ec68ca3641fb3c4686e6182762bb759&amp;type=3#AbstractMountStatusHeaderStatus"/>
                    <ui:Column title="Proc S" cell-template="project://database/Assets/UIDocuments/Templates/MountStatus/MountStatusCellProcessSeconds.uxml?fileID=9197481963319205126&amp;guid=337b4d9f9cd71ab43b125950dfb24a74&amp;type=3#MountStatusCellProcessSeconds" width="10%" header-template="project://database/Assets/UIDocuments/Templates/MountStatus/MountStatusHeaderProcessSeconds.uxml?fileID=9197481963319205126&amp;guid=3002ddf791f3dc7429e94d63dac7c013&amp;type=3#MountStatusHeaderProcessSeconds"/>
                    <ui:Column title="Ammo" cell-template="project://database/Assets/UIDocuments/Templates/MountStatus/MountStatusCellAmmunitionType.uxml?fileID=9197481963319205126&amp;guid=ca3ca56a3f8183a45b10f1055f5edd8c&amp;type=3#MountStatusCellAmmunitionType" width="10%" header-template="project://database/Assets/UIDocuments/Templates/MountStatus/MountStatusHeaderAmmunitionType.uxml?fileID=9197481963319205126&amp;guid=1cf71e4513100f341a6c52bbebe42486&amp;type=3#MountStatusHeaderAmmunitionType"/>
                    <ui:Column width="30%" name="firingTarget" title="Firing Target" cell-template="project://database/Assets/UIDocuments/Templates/AbstractMountStatus/AbstractMountStatusCellFiringTarget.uxml?fileID=9197481963319205126&amp;guid=c710d004ac89c594cab790bf1afe6d2a&amp;type=3#AbstractMountStatusCellFiringTarget" header-template="project://database/Assets/UIDocuments/Templates/AbstractMountStatus/AbstractMountStatusHeaderFiringTarget.uxml?fileID=9197481963319205126&amp;guid=a7c594857ecc8c24cbedcf6e3b4ab7f0&amp;type=3#AbstractMountStatusHeaderFiringTarget"/>
                    <ui:Column title="Detail" width="10%" cell-template="project://database/Assets/UIDocuments/Templates/MountStatus/MountStatusCellDetailButton.uxml?fileID=9197481963319205126&amp;guid=24dbe90633e0855488d1fe10d1d10add&amp;type=3#MountStatusCellDetailButton" name="detail" header-template="project://database/Assets/UIDocuments/Templates/MountStatus/MountStatusHeaderDetailButton.uxml?fileID=9197481963319205126&amp;guid=3287c96f5e15da24cbbfca56e869143f&amp;type=3#MountStatusHeaderDetailButton"/>
                </ui:Columns>
            </ui:MultiColumnListView>
            <ui:MultiColumnListView name="FireControlSystemMultiColumnListView" binding-source-selection-mode="AutoAssign" data-source-path="fireControlSystemStatusRecords" show-add-remove-footer="true" style="flex-shrink: 0;">
                <ui:Columns>
                    <ui:Column title="Info" cell-template="project://database/Assets/UIDocuments/Templates/FireControlSystemStatusRecord/FireControlSystemStatusRecordInfo.uxml?fileID=9197481963319205126&amp;guid=69901079725c8bb4891fc5e99a273588&amp;type=3#FireControlSystemStatusRecordInfo" width="20%" header-template="project://database/Assets/UIDocuments/Templates/FireControlSystemStatusRecord/FireControlSystemStatusRecordInfoHeader.uxml?fileID=9197481963319205126&amp;guid=57eb4fda4d2d63b44adb48b626750cf0&amp;type=3#FireControlSystemStatusRecordInfoHeader"/>
                    <ui:Column title="State" width="25%" cell-template="project://database/Assets/UIDocuments/Templates/FireControlSystemStatusRecord/FireControlSystemStatusRecordTrackingState.uxml?fileID=9197481963319205126&amp;guid=8054ea02c4bd2af4f864b76234e2059c&amp;type=3#FireControlSystemStatusRecordTrackingState" header-template="project://database/Assets/UIDocuments/Templates/FireControlSystemStatusRecord/FireControlSystemStatusRecordTrackingStateHeader.uxml?fileID=9197481963319205126&amp;guid=6031dfc96c3bd1e4589358fda7949eeb&amp;type=3#FireControlSystemStatusRecordTrackingStateHeader"/>
                    <ui:Column width="15%" title="TK Seconds" cell-template="project://database/Assets/UIDocuments/Templates/FireControlSystemStatusRecord/FireControlSystemStatusRecordTrackingSeconds.uxml?fileID=9197481963319205126&amp;guid=9ac4ec727ad405745a0fd4f7e41ed468&amp;type=3#FireControlSystemStatusRecordTrackingSeconds" header-template="project://database/Assets/UIDocuments/Templates/FireControlSystemStatusRecord/FireControlSystemStatusRecordTrackingSecondsHeader.uxml?fileID=9197481963319205126&amp;guid=d667b2326164976478bda279a423bdb5&amp;type=3#FireControlSystemStatusRecordTrackingSecondsHeader"/>
                    <ui:Column name="target" title="Target" cell-template="project://database/Assets/UIDocuments/Templates/FireControlSystemStatusRecord/FireControlSystemStatusRecordTarget.uxml?fileID=9197481963319205126&amp;guid=5f191d2984361ac49966fa831bded75d&amp;type=3#FireControlSystemStatusRecordTarget" width="40%" header-template="project://database/Assets/UIDocuments/Templates/FireControlSystemStatusRecord/FireControlSystemStatusRecordTargetHeader.uxml?fileID=9197481963319205126&amp;guid=9399e60eb26019b4f80f120fd31d5bac&amp;type=3#FireControlSystemStatusRecordTargetHeader"/>
                </ui:Columns>
            </ui:MultiColumnListView>
            <Bindings>
                <ui:DataBinding property="style.display" data-source-path="batteryRecord" binding-mode="ToTarget" source-to-ui-converters="BatteryRecord =&gt; DisplayStyle"/>
            </Bindings>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
