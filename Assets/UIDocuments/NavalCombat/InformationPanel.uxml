<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement data-source-type="GameManager, Assembly-CSharp" data-source-path="selectedShipLog" class="panel hud-info-panel" style="flex-grow: 1; width: 210px;">
        <ui:ScrollView>
            <ui:VisualElement>
                <ui:Label text="Ship&apos;s name " name="NamedShipLabel" style="white-space: normal; flex-wrap: wrap;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="namedShipDescLink" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Image name="ClassImage" class="hud-image-frame" style="max-height: 50px;">
                    <Bindings>
                        <ui:DataBinding property="source" data-source-path="shipClassProperty.portraitIconReference.texture2d" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Image>
                <ui:Label text="ClassLabel" name="ClassLabel" style="white-space: normal;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="shipClassDescLink" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="Ship&apos;sOobParent" name="OOBParentLabel" style="white-space: normal;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="oobParentDescLink" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                    <ui:VisualElement style="flex-grow: 1;">
                        <ui:Label text="Ship&apos;s captain ....................................................." name="CaptainLabel" style="white-space: normal;">
                            <Bindings>
                                <ui:DataBinding property="text" data-source-path="captainDescLink" binding-mode="ToTarget"/>
                            </Bindings>
                        </ui:Label>
                    </ui:VisualElement>
                    <ui:Image name="LeaderImage" class="hud-image-frame" style="flex-shrink: 0; flex-basis: 40px; max-height: 50px;">
                        <Bindings>
                            <ui:DataBinding property="source" data-source-path="captainPortraitTexture" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Image>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
                    <ui:Label text="Speed (kts):">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(197904029093888)"/>
                        </Bindings>
                    </ui:Label>
                    <ui:Label text="speedKnots">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="speedKnots" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:Slider high-value="100" show-input-field="true">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="desiredSpeedKnots" binding-mode="TwoWay"/>
                        <ui:DataBinding property="highValue" data-source-path="maxSpeedKnotsProp" binding-mode="ToTarget"/>
                        <ui:DataBinding property="lowValue" data-source-path="minSpeedKnotsProp" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Slider>
                <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
                    <ui:Label text="Heading (deg):">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(197982118645760)"/>
                        </Bindings>
                    </ui:Label>
                    <ui:Label text="heading">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="headingDeg" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:Slider high-value="360" show-input-field="true">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="desiredHeadingDeg" binding-mode="TwoWay"/>
                    </Bindings>
                </ui:Slider>
                <ui:ProgressBar>
                    <Bindings>
                        <ui:DataBinding property="highValue" data-source-path="shipClassProperty.damagePoint" binding-mode="ToTarget"/>
                        <ui:DataBinding property="value" data-source-path="damagePoint" binding-mode="ToTarget"/>
                        <ui:DataBinding property="title" data-source-path="damagePointProgrssDescShort" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:ProgressBar>
                <ui:Label text="_ DEs" style="white-space: normal;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="damageEffectDesc" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Button text="Set Attack Target (A)" name="SetAttackTargetButton">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(47647284608536576)"/>
                    </Bindings>
                </ui:Button>
                <ui:Label text="Manual Attack Target Desc" style="white-space: normal;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="shipLevelFiringTargetDesc" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:VisualElement class="weapon-summary-group">
                    <ui:VisualElement class="weapon-summary-card">
                        <ui:Label text="Battery" class="weapon-summary-title">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(67032395190272)"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Label text="batterySummary" name="BatterySummaryLabel" class="weapon-summary-content" style="white-space: normal;">
                            <Bindings>
                                <ui:DataBinding property="text" data-source-path="batterySummary" binding-mode="ToTarget"/>
                            </Bindings>
                        </ui:Label>
                    </ui:VisualElement>
                    <ui:VisualElement class="weapon-summary-card">
                        <ui:Label text="Rapid Firing Battery" class="weapon-summary-title">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(67081078476800)"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Label text="rapidFiringSummary" name="RapidFiringSummaryLabel" class="weapon-summary-content" style="white-space: normal;">
                            <Bindings>
                                <ui:DataBinding property="text" data-source-path="rapidFiringSummary" binding-mode="ToTarget"/>
                            </Bindings>
                        </ui:Label>
                    </ui:VisualElement>
                    <ui:VisualElement class="weapon-summary-card">
                        <ui:Label text="Torpedo" class="weapon-summary-title">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(67160241770496)"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Label text="torpedoSummary" name="TorpedoSummaryLabel" class="weapon-summary-content" style="white-space: normal;">
                            <Bindings>
                                <ui:DataBinding property="text" data-source-path="torpedoSummary" binding-mode="ToTarget"/>
                            </Bindings>
                        </ui:Label>
                    </ui:VisualElement>
                </ui:VisualElement>
                <Bindings>
                    <ui:DataBinding property="style.display" binding-mode="ToTarget" source-to-ui-converters="ShipLog to DisplayStyle"/>
                </Bindings>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
