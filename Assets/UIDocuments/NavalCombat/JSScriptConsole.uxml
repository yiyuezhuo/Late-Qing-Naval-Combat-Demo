                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:TextField readonly="true" name="OutputTextField" multiline="true" vertical-scroller-visibility="Auto" style="height: 200px; white-space: normal;" />
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-shrink: 0;">
                <ui:Label text="Input:">
                    <Bindings>
