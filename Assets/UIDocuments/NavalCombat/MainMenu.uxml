<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UIDocuments/styles/style.uss?fileID=7433441132597879392&amp;guid=2bc9a89e260078e449dd456da4bfcf64&amp;type=3#style" />
    <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Textures/NavalCombat/Map_of_Battle_of_the_Yalu_River_(1894).jpg?fileID=2800000&amp;guid=edfed1be4dcc485499ee5126922bcbe2&amp;type=3#Map_of_Battle_of_the_Yalu_River_(1894)&quot;); -unity-background-scale-mode: scale-and-crop;" />
    <ui:VisualElement style="position: absolute; align-self: center; bottom: 0; top: 0; justify-content: center;">
        <ui:ScrollView>
            <ui:VisualElement style="flex-grow: 1; padding-top: 5px; padding-bottom: 5px; max-height: 100%; padding-right: 5px; padding-left: 5px; background-color: rgba(255, 255, 255, 0.78);">
                <ui:Label text="First Sino-Japanese War" style="font-size: 38px; -unity-text-align: upper-center;">
