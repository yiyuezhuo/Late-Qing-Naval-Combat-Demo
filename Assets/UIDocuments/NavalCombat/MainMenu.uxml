                            </Bindings>
                        </ui:Button>
                        <ui:Button text="(DEBUG) Strategic Mode Test" name="StrategicModeTestButton" class="verylarge">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(363410065362944)" />
                            </Bindings>
                        </ui:Button>
                        <ui:Button text="Setting" name="SettingButton" class="verylarge">
