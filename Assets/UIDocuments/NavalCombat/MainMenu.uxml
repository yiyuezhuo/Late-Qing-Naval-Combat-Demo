<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="StrategicStartup" src="project://database/Assets/UIDocuments/Common/StrategicStartup.uxml?fileID=9197481963319205126&amp;guid=bfad67099216fb148958e4382e3c1de6&amp;type=3#StrategicStartup"/>
    <Style src="project://database/Assets/UIDocuments/styles/style.uss?fileID=7433441132597879392&amp;guid=2bc9a89e260078e449dd456da4bfcf64&amp;type=3#style"/>
    <ui:VisualElement data-source-type="MainMenu, Assembly-CSharp" class="main-menu-background" style="flex-grow: 1; -unity-background-scale-mode: scale-and-crop;">
        <Bindings>
            <ui:DataBinding property="style.backgroundImage" data-source-path="mainMenuBackground" binding-mode="ToTarget"/>
        </Bindings>
    </ui:VisualElement>
    <ui:VisualElement data-source-type="MainMenu, Assembly-CSharp" style="position: absolute; align-self: center; bottom: 0; top: 0; justify-content: center;">
        <ui:ScrollView>
            <ui:VisualElement class="main-menu-panel" style="flex-grow: 1; padding-top: 5px; padding-bottom: 5px; max-height: 100%; padding-right: 5px; padding-left: 5px;">
                <ui:Label text="First Sino-Japanese War" class="main-menu-title">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(3101437890560)"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="And the East Asian Pre-Dreadnought Era" class="main-menu-subtitle">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(44380493585223680)"/>
                    </Bindings>
                </ui:Label>
                <ui:VisualElement style="flex-direction: row; width: 700px;">
                    <ui:VisualElement style="flex-grow: 1; flex-basis: 100px;">
                        <ui:Label text="Tactical Naval Combat" class="main-menu-column-title" style="display: none;">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(40329044639256576)"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Button text="Select  Scenario" name="SelectScenarioButton" class="verylarge">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(5242554585088)"/>
                            </Bindings>
                        </ui:Button>
                        <ui:Button text="Load Game" name="LoadGameButton" class="verylarge">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(6575349207040)"/>
                            </Bindings>
                        </ui:Button>
                        <ui:Button text="Skirmish" name="SkirmishButton" class="verylarge">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(34615076230696960)"/>
                            </Bindings>
                        </ui:Button>
                        <ui:Button text="Start As Empty" name="StartAsEmptyButton" class="verylarge">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(34615625252507648)"/>
                            </Bindings>
                        </ui:Button>
                        <ui:Button text="Campaign" name="CampaignButton" class="verylarge">
                            <Bindings>
                                <ui:DataBinding property="enabled" data-source-path="isDebug" binding-mode="ToTarget"/>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(58877035788537856)"/>
                            </Bindings>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; display: none; flex-basis: 100px;">
                        <ui:Label text="Strategic" class="main-menu-column-title">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(13052626003988480)"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Instance template="StrategicStartup" name="StrategicStartup"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; flex-basis: 100px;">
                        <ui:Label text="Misc" class="main-menu-column-title" style="display: none;">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(40329917863989248)"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Button text="Setting" name="SettingButton" class="verylarge">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(6979457814528)"/>
                            </Bindings>
                        </ui:Button>
                        <ui:Button text="Calculator" name="CalculatorButton" class="verylarge" style="display: none;">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(-108)"/>
                            </Bindings>
                        </ui:Button>
                        <ui:Button text="NAAB-like Calculator" name="NaabLikeCalculatorButton" class="verylarge" style="display: none;">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(-112)"/>
                            </Bindings>
                        </ui:Button>
                        <ui:Button text="McCoy Okun Calculator" name="McCoyOkunCalculatorButton" class="verylarge">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(-164)"/>
                            </Bindings>
                        </ui:Button>
                        <ui:Button text="Manual" name="ManualButton" class="verylarge">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(33508883324112896)"/>
                            </Bindings>
                        </ui:Button>
                        <ui:Button text="Changelog" name="ChangelogButton" class="verylarge">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(-119)"/>
                            </Bindings>
                        </ui:Button>
                        <ui:Button text="About" name="AboutButton" class="verylarge">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(-83)"/>
                            </Bindings>
                        </ui:Button>
                        <ui:Button text="Exit" name="ExitButton" class="verylarge">
                            <Bindings>
                                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(7141114679296)"/>
                            </Bindings>
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: center; height: 20px;">
                    <ui:Button icon-image="project://database/Assets/Textures/GitHub_Invertocat_White.png?fileID=2800000&amp;guid=788cf74ca55c1994db5d65f5c6fd38b1&amp;type=3#GitHub_Invertocat_White" text="" name="GitHubButton" style="margin-top: 0; margin-bottom: 0; width: 20px; padding-left: 0; padding-right: 0;"/>
                </ui:VisualElement>
                <ui:Label text="Version" name="VersionLabel" data-source-type="MainMenu, Assembly-CSharp" style="-unity-text-align: upper-center;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="versionStr" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
