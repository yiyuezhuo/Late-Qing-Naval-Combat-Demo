                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(3101437890560)" />
                    </Bindings>
                </ui:Label>
                <ui:VisualElement style="flex-direction: row;">
                    <ui:VisualElement style="flex-grow: 1;">
                        <ui:Button text="Select Naval Tactical Scenario" name="SelectScenarioButton" class="verylarge">
