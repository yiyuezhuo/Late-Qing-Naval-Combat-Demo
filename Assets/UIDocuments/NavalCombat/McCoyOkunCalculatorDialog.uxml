<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="McCoyOkunCalculatorRoot" style="width: 1050px; height: 600px; flex-grow: 1; flex-shrink: 1;">
        <ui:TabView name="McCoyOkunTabView" style="flex-grow: 1; flex-shrink: 1;">
            <ui:Tab label="M79 APCLC">
            <ui:VisualElement name="M79ApclcPage" class="mccoy-okun-page" style="flex-direction: row; flex-grow: 1; flex-shrink: 1;">
                <ui:ScrollView name="M79ApclcInput" mode="Vertical" class="mccoy-okun-input" style="flex-basis: 340px; flex-shrink: 0; margin-right: 8px;">
                    <ui:VisualElement style="flex-direction: row; margin-bottom: 6px;"><ui:Label text="M79 APCLC" style="-unity-font-style: bold; flex-grow: 1;" /><ui:Button name="M79ApclcResetButton" text="Reset" /></ui:VisualElement>
                    <ui:DropdownField name="M79ApclcSampleField" label="Sample" />
                    <ui:FloatField name="M79ApclcProjectileDiameterField" label="Projectile Diameter" />
                    <ui:FloatField name="M79ApclcProjectileWeightField" label="Projectile Weight" />
                    <ui:FloatField name="M79ApclcPlateThicknessField" label="Plate Thickness" />
                    <ui:FloatField name="M79ApclcPlateQualityField" label="Plate Quality" />
                    <ui:FloatField name="M79ApclcObliquityField" label="Obliquity" />
                    <ui:FloatField name="M79ApclcStrikingVelocityField" label="Striking Velocity" />
                    <ui:FloatField name="M79ApclcElongationField" label="Elongation" />
                </ui:ScrollView>
                <ui:ScrollView name="M79ApclcOutput" mode="Vertical" class="mccoy-okun-output" style="flex-grow: 1; flex-shrink: 1;"><ui:VisualElement name="M79ApclcOutputContent" /></ui:ScrollView>
            </ui:VisualElement>
            </ui:Tab>
            <ui:Tab label="Facehard69">
            <ui:VisualElement name="Facehard69Page" class="mccoy-okun-page" style="flex-direction: row; flex-grow: 1; flex-shrink: 1;">
                <ui:ScrollView name="Facehard69Input" mode="Vertical" class="mccoy-okun-input" style="flex-basis: 340px; flex-shrink: 0; margin-right: 8px;">
                    <ui:VisualElement style="flex-direction: row; margin-bottom: 6px;"><ui:Label text="Facehard69 Baseline" style="-unity-font-style: bold; flex-grow: 1;" /><ui:Button name="Facehard69ResetButton" text="Reset" /></ui:VisualElement>
                    <ui:DropdownField name="Facehard69SampleField" label="Sample" />
                    <ui:VisualElement style="flex-direction: row; margin-bottom: 6px;"><ui:Button name="Facehard69RecordButton" text="Record Current Velocity and Obliquity" style="flex-grow: 1;" /><ui:Button name="Facehard69ClearButton" text="Clear" /></ui:VisualElement>
                    <ui:DropdownField name="Facehard69ProjectileNationField" label="Projectile Nation" />
                    <ui:DropdownField name="Facehard69ProjectileTypeField" label="Projectile Type" />
                    <ui:DropdownField name="Facehard69CapOrHoodField" label="Cap Or Hood" />
                    <ui:DropdownField name="Facehard69NoseSchemaField" label="Nose Schema" />
                    <ui:DropdownField name="Facehard69JapaneseCapHeadField" label="Japanese Cap Head Type" />
                    <ui:DropdownField name="Facehard69NoseConditionField" label="Pre-Impact Nose Condition" />
                    <ui:FloatField name="Facehard69ProjectileDiameterField" label="Projectile Diameter" />
                    <ui:FloatField name="Facehard69ProjectileWeightField" label="Projectile Weight" />
                    <ui:FloatField name="Facehard69ProjectileBodyWeightField" label="Projectile Body Weight" />
                    <ui:FloatField name="Facehard69WindscreenCapHeadWeightField" label="Windscreen + Cap Head Weight" />
                    <ui:FloatField name="Facehard69WindscreenWeightField" label="Windscreen Weight" />
                    <ui:FloatField name="Facehard69RemainingNoseWeightField" label="Remaining Nose Covering Weight" />
                    <ui:FloatField name="Facehard69PlimField" label="PLIM" />
                    <ui:FloatField name="Facehard69PdamField" label="PDAM" />
                    <ui:FloatField name="Facehard69StrikingVelocityField" label="Striking Velocity" />
                    <ui:FloatField name="Facehard69ObliquityField" label="Obliquity" />
                    <ui:DropdownField name="Facehard69ArmorTypeField" label="Armor Type" />
                    <ui:Toggle name="Facehard69CurvedPlateToggle" label="Strongly Curved Plate" />
                    <ui:FloatField name="Facehard69PlateThicknessField" label="Plate Thickness" />
                    <ui:FloatField name="Facehard69WoodBackingField" label="Wood Backing" />
                    <ui:FloatField name="Facehard69CementBackingField" label="Cement Backing" />
                    <ui:FloatField name="Facehard69MetalBackingField" label="Metal Backing" />
                    <ui:FloatField name="Facehard69BackingQualityField" label="Backing Quality" />
                    <ui:FloatField name="Facehard69BackingPlatesField" label="Backing Plates" />
                    <ui:VisualElement name="Facehard69InputWarnings" />
                </ui:ScrollView>
                <ui:ScrollView name="Facehard69Output" mode="Vertical" class="mccoy-okun-output" style="flex-grow: 1; flex-shrink: 1;"><ui:VisualElement name="Facehard69OutputContent" /></ui:ScrollView>
            </ui:VisualElement>
            </ui:Tab>
            <ui:Tab label="McCoy">
            <ui:VisualElement name="McCoyPage" class="mccoy-okun-page" style="flex-direction: row; flex-grow: 1; flex-shrink: 1;">
                <ui:ScrollView name="McCoyInput" mode="Vertical" class="mccoy-okun-input" style="flex-basis: 340px; flex-shrink: 0; margin-right: 8px;">
                    <ui:VisualElement style="flex-direction: row; margin-bottom: 6px;"><ui:Label text="McCoy Point-Mass Trajectory" style="-unity-font-style: bold; flex-grow: 1;" /><ui:Button name="McCoyResetButton" text="Reset" /></ui:VisualElement>
                    <ui:DropdownField name="McCoyAtmosphereField" label="Atmosphere Model" />
                    <ui:FloatField name="McCoyMuzzleVelocityField" label="Muzzle Velocity" />
                    <ui:FloatField name="McCoyBallisticCoefficientField" label="Ballistic Coefficient" />
                    <ui:FloatField name="McCoySightHeightField" label="Sight Height" />
                    <ui:FloatField name="McCoyElevationMinutesField" label="Elevation" />
                    <ui:FloatField name="McCoyDensityRatioField" label="Density Ratio" />
                    <ui:FloatField name="McCoyTemperatureField" label="Temperature" />
                    <ui:FloatField name="McCoyPrintIntervalField" label="Print Interval" />
                    <ui:FloatField name="McCoyMaxRangeField" label="Maximum Range" />
                    <ui:FloatField name="McCoyRangeWindField" label="Range Wind" />
                    <ui:FloatField name="McCoyCrossWindField" label="Crosswind" />
                    <ui:FloatField name="McCoyMatchRangeField" label="Match Range" />
                    <ui:FloatField name="McCoyMatchHeightField" label="Match Height" />
                    <ui:TextField name="McCoyDragTableField" label="Mach-CD Drag Table" multiline="true" style="height: 120px;" />
                </ui:ScrollView>
                <ui:ScrollView name="McCoyOutput" mode="Vertical" class="mccoy-okun-output" style="flex-grow: 1; flex-shrink: 1;"><ui:VisualElement name="McCoyOutputContent" /></ui:ScrollView>
            </ui:VisualElement>
            </ui:Tab>
