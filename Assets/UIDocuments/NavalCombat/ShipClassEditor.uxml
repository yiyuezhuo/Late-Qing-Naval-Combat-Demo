                                                        <ui:Column name="speedKnots" title="Speed (knots)" width="50%" cell-template="project://database/Assets/UIDocuments/Templates/TorpedoSetting/TorpedoSettingCellSpeed.uxml?fileID=9197481963319205126&amp;guid=6eaa20422539daf41ad1a7dc0f8f657b&amp;type=3#TorpedoSettingCellSpeed" header-template="project://database/Assets/UIDocuments/Templates/TorpedoSetting/TorpedoSettingHeaderSpeed.uxml?fileID=9197481963319205126&amp;guid=c69f23b7832262a4395c29d6cf574906&amp;type=3#TorpedoSettingHeaderSpeed" />
                                                    </ui:Columns>
