                                                    </Bindings>
                                                </ui:EnumField>
                                                <ui:Slider label="Dub Probability" value="0.5" high-value="1" show-input-field="true">
                                                    <Bindings>
                                                        <ui:DataBinding property="value" data-source-path="dudProbability" binding-mode="TwoWay" />
                                                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(82584522100736)" />
                                                    </Bindings>
