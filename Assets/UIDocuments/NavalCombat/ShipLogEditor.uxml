                                                </Bindings>
                                            </ui:FloatField>
                                            <ui:FloatField label="Firepower" readonly="true">
                                                <Bindings>
                                                    <ui:DataBinding property="value" data-source-path="firepoweScoreProp" binding-mode="ToTarget" />
                                                    <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(91012703358976)" />
