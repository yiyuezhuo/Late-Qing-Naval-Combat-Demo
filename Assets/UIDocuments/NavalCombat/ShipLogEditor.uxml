                                                <ui:Column name="lat" cell-template="project://database/Assets/UIDocuments/Templates/TimeLoc/TimeLocLatDeg.uxml?fileID=9197481963319205126&amp;guid=117edb5e87e300148893b7cbc050b5ec&amp;type=3#TimeLocLatDeg" width="33%" title="Lat" />
                                                <ui:Column name="lon" title="Lon" width="33%" cell-template="project://database/Assets/UIDocuments/Templates/TimeLoc/TimeLocLonDeg.uxml?fileID=9197481963319205126&amp;guid=84ffd55a81957b44bb57520ef661a118&amp;type=3#TimeLocLonDeg" />
