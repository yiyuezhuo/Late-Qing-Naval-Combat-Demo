                                                    <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(91326852534272)" />
                                                </Bindings>
                                            </ui:FloatField>
                                            <ui:FloatField label="Bty Port FP" readonly="true">
                                                <Bindings>
