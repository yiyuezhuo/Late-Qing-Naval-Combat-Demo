                <ui:Button text="Next" name="NextButton" style="width: 120px;">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(-46)"/>
                    </Bindings>
                </ui:Button>
                <ui:Button text="Export CSV" name="ExportCsvButton" style="width: 140px;">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(-49)"/>
                    </Bindings>
                </ui:Button>
            </ui:VisualElement>
            <ui:MultiColumnListView name="GainListView" fixed-item-height="24" style="flex-grow: 1; min-height: 320px;"/>
            <ui:VisualElement style="flex-direction: row; gap: 6px; flex-shrink: 0;">
                <ui:DropdownField name="PrimarySortDropdownField" label="Primary Sort" style="flex-grow: 1;">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(-47)"/>
                    </Bindings>
                </ui:DropdownField>
                <ui:DropdownField name="SecondarySortDropdownField" label="Secondary Sort" style="flex-grow: 1;">
