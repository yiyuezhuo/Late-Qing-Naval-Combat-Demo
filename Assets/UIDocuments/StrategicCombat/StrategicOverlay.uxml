<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="StrategicInformationPanel" src="project://database/Assets/UIDocuments/StrategicCombat/StrategicInformationPanel.uxml?fileID=9197481963319205126&amp;guid=9f9bc0290d3dcf348856ddad27571109&amp;type=3#StrategicInformationPanel"/>
    <ui:Template name="StrategicTopTabs" src="project://database/Assets/UIDocuments/StrategicCombat/StrategicTopTabs.uxml?fileID=9197481963319205126&amp;guid=8ea38bc395056514380ad7e8dfdb2b39&amp;type=3#StrategicTopTabs"/>
    <ui:Instance template="StrategicTopTabs" style="right: 270px; left: 0; position: absolute;"/>
    <ui:VisualElement name="StrategicTimePanel" class="strategic-time-panel" style="position: absolute; right: 0; top: 0; min-width: 275px;">
        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement class="strategic-time-row" style="flex-direction: column; flex-shrink: 0; width: 205px; min-width: 205px; max-width: 205px;">
                <ui:Label text="0000-00-00 00:00:00 +0" name="StrategicTimeValueLabel" class="strategic-time-value"/>
                <ui:Label text="Paused | Normal" name="StrategicTimeStatusLabel" class="strategic-time-status"/>
            </ui:VisualElement>
            <ui:Button text="&gt;" name="StrategicTimePlayPauseButton" class="strategic-time-play-button" style="min-width: 42px; height: 42px; width: 42px; font-size: 24px; max-width: 42px; padding-right: 12px; margin-right: 4px;"/>
        </ui:VisualElement>
        <ui:VisualElement class="strategic-time-speed-row">
            <ui:Button text="Slow" name="StrategicTimeSlowButton" class="strategic-time-speed-button"/>
            <ui:Button text="Normal" name="StrategicTimeNormalButton" class="strategic-time-speed-button"/>
            <ui:Button text="Fast" name="StrategicTimeFastButton" class="strategic-time-speed-button" style="margin-right: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Instance template="StrategicInformationPanel" style="position: absolute; right: 0; bottom: 0; top: 90px;"/>
    <ui:VisualElement data-source-type="StrategicGameManager, Assembly-CSharp" class="hud-log-panel" style="flex-grow: 1; bottom: 0; left: 0; position: absolute; width: 350px; height: 150px;">
        <ui:VisualElement class="hud-log-header" style="flex-grow: 0; flex-direction: row;">
            <ui:Label text="Logs">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(198656025858048)"/>
                </Bindings>
            </ui:Label>
            <ui:VisualElement style="flex-grow: 1;"/>
            <ui:Label text="Current Only">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(198769003630592)"/>
                </Bindings>
            </ui:Label>
            <ui:Toggle name="CurrentLogOnlyToggle">
                <Bindings>
                    <ui:DataBinding property="value" data-source-path="currentLogOnly" binding-mode="TwoWay"/>
                </Bindings>
            </ui:Toggle>
            <ui:Button text="Clear" name="ClearLogButton">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(180255345774592)"/>
                </Bindings>
            </ui:Button>
        </ui:VisualElement>
        <ui:ListView name="LastLogListView" data-source-path="displayedLogs" binding-source-selection-mode="AutoAssign" item-template="project://database/Assets/UIDocuments/Templates/SidedLazyLocalizedStringLabel.uxml?fileID=9197481963319205126&amp;guid=a99106e670f344e499e6054a8b94489b&amp;type=3#SidedLazyLocalizedStringLabel" virtualization-method="DynamicHeight" fixed-item-height="10" style="flex-grow: 1;"/>
    </ui:VisualElement>
</ui:UXML>
