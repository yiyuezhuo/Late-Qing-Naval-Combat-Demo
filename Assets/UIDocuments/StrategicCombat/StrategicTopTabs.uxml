<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 0; background-color: rgba(255, 255, 255, 0.49);">
        <ui:TabView data-source-type="StrategicGameManager, Assembly-CSharp">
            <ui:Tab label="Map Edit">
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-wrap: wrap;">
                    <ui:Label text="Mode">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(362247664340992)" />
                        </Bindings>
                    </ui:Label>
                    <ui:EnumField value="Center" type="StrategicMapEditMode, Assembly-CSharp" style="min-width: 100px;">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="mapEditMode" binding-mode="TwoWay" />
                        </Bindings>
                    </ui:EnumField>
                    <ui:Label text="Terrain">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(348352971182080)" />
                        </Bindings>
                    </ui:Label>
                    <ui:EnumField value="Center" type="StrategicCombatCore.TerrainType, Assembly-CSharp" style="min-width: 100px;">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="currentTerrainType" binding-mode="TwoWay" />
                        </Bindings>
                    </ui:EnumField>
                    <ui:Label text="Hex Pair Feature">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(348401381838848)" />
                        </Bindings>
                    </ui:Label>
                    <ui:EnumField value="Center" type="StrategicCombatCore.EdgeFeatureType, Assembly-CSharp" style="min-width: 100px;">
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="currentEdgeFeatureType" binding-mode="TwoWay" />
                        </Bindings>
                    </ui:EnumField>
                    <ui:Label text="Width">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(348472202661888)" />
                        </Bindings>
                    </ui:Label>
                    <ui:IntegerField>
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="tempMapWidth" binding-mode="TwoWay" />
                        </Bindings>
                    </ui:IntegerField>
                    <ui:Label text="Height">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(348760607199232)" />
                        </Bindings>
                    </ui:Label>
                    <ui:IntegerField>
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="tempMapHeight" binding-mode="TwoWay" />
                        </Bindings>
                    </ui:IntegerField>
                    <ui:Button text="Generate Map" name="GenerateMapButton">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(348843553755136)" />
                        </Bindings>
                    </ui:Button>
                    <ui:Label text="Reference Map">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(348895013670912)" />
                        </Bindings>
                    </ui:Label>
                    <ui:Toggle>
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="showReferenceMap" binding-mode="TwoWay" />
                        </Bindings>
                    </ui:Toggle>
                    <ui:Label text="Border">
                        <Bindings>
                            <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(349057530368000)" />
                        </Bindings>
                    </ui:Label>
                    <ui:Toggle>
                        <Bindings>
                            <ui:DataBinding property="value" data-source-path="showBorder" binding-mode="TwoWay" />
                        </Bindings>
                    </ui:Toggle>
                    <ui:Label text="Accurate  Sea Land">
