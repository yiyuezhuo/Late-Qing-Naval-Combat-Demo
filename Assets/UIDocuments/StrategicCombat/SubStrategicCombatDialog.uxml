<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="CombatSideStateView" src="project://database/Assets/UIDocuments/StrategicCombat/CombatSideStateView.uxml?fileID=9197481963319205126&amp;guid=e4f2defc8051c184582353143ebb1374&amp;type=3#CombatSideStateView" />
    <ui:VisualElement data-source-type="StrategicCombatCore.SubStrategicCombat, Assembly-CSharp" class="panel-dialog" style="width: 1000px; height: 600px;">
        <ui:Label text="Sub Strategic Combat Resolver" class="title" />
        <ui:VisualElement style="flex-grow: 1;">
            <ui:Label text="Combat Info" />
            <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
                <ui:Button text="Confirm" name="ConfirmButton" />
                <ui:Button text="Step" name="StepButton" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
                <ui:EnumField label="Type" value="Center" type="StrategicCombatCore.SubStrategicCombatType, Assembly-CSharp" style="flex-grow: 1; flex-basis: 10px;">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="type" binding-mode="TwoWay" />
                    </Bindings>
                </ui:EnumField>
                <ui:Label text="Turn (5min)" />
                <ui:FloatField style="flex-basis: 50px; flex-grow: 0;">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="currentTurn" binding-mode="TwoWay" />
                    </Bindings>
                </ui:FloatField>
                <ui:Label text="/" />
                <ui:FloatField style="flex-basis: 50px; flex-grow: 0;">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="maxTurn" binding-mode="TwoWay" />
                    </Bindings>
                </ui:FloatField>
                <ui:FloatField label="Range (Meter)" style="flex-basis: 10px; flex-grow: 1;">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="distanceMeterProp" binding-mode="TwoWay" />
                    </Bindings>
                </ui:FloatField>
                <ui:FloatField label="Width (Meter)" style="flex-grow: 1; flex-basis: 10px;">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="widthMeter" binding-mode="TwoWay" />
                    </Bindings>
                </ui:FloatField>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; border-top-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);">
                <ui:VisualElement style="flex-grow: 1; flex-basis: 100px; border-right-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);">
                    <ui:Label text="Attackers:" />
                    <ui:Instance template="CombatSideStateView" name="CombatSideStateView" data-source-path="attacker" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-basis: 100px;">
                    <ui:Label text="Defenders:" />
                    <ui:Instance template="CombatSideStateView" data-source-path="defender" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
