<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UIDocuments/styles/style.uss?fileID=7433441132597879392&amp;guid=2bc9a89e260078e449dd456da4bfcf64&amp;type=3#style"/>
    <ui:VisualElement data-source-type="StrategicCombatCore.StrategicGameState, Assembly-CSharp" class="panel-dialog" style="width: 520px; height: 420px;">
        <ui:Label text="Theater Selector" class="title">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(-97000000000002)"/>
            </Bindings>
        </ui:Label>
        <ui:DropdownField name="DisplayModeDropdownField" label="Display Mode" style="margin-bottom: 4px;">
            <Bindings>
                <UnityEngine.Localization.LocalizedString property="label" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(-97000000000005)"/>
            </Bindings>
        </ui:DropdownField>
        <ui:ListView name="TheaterListView" binding-source-selection-mode="AutoAssign" item-template="project://database/Assets/UIDocuments/Templates/TheaterListItem.uxml?fileID=9197481963319205126&amp;guid=1cb5240fcfc44fbcba26755d95d930aa&amp;type=3#TheaterListItem" fixed-item-height="28" style="flex-grow: 1;"/>
        <ui:VisualElement style="flex-direction: row; flex-shrink: 0;">
            <ui:Button text="Clear" name="ClearButton" style="flex-basis: 50px; flex-grow: 1;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(180255345774592)"/>
                </Bindings>
            </ui:Button>
            <ui:Button text="Refresh" name="RefreshButton" style="flex-basis: 50px; flex-grow: 1;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(16180543747690496)"/>
                </Bindings>
            </ui:Button>
            <ui:Button text="Cancel" name="CancelButton" style="flex-basis: 50px; flex-grow: 1;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(66269346435072)"/>
                </Bindings>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
