<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement data-source-type="NavalCombatCore.ShipClass, Assembly-CSharp" style="-unity-background-scale-mode: scale-to-fit;">
        <ui:VisualElement style="flex-grow: 1; position: absolute; height: 100%; right: 0; -unity-background-scale-mode: scale-to-fit;">
            <Bindings>
                <ui:DataBinding property="style.width" data-source-path="portraitWidth" binding-mode="ToTarget" />
                <ui:DataBinding property="style.backgroundImage" data-source-path="portraitIconReference.pictureStyleBackground" binding-mode="ToTarget" />
            </Bindings>
        </ui:VisualElement>
        <ui:Button text="&lt; Ship Class&apos;s Name (100)" style="-unity-text-align: middle-left; padding-left: 2px; padding-right: 2px; margin-left: 2px; margin-right: 2px;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="forceBuilderText" binding-mode="ToTarget" />
            </Bindings>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
