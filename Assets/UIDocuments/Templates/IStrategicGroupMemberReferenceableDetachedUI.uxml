<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement data-source-type="StrategicCombatCore.StrategicGroup, Assembly-CSharp" style="flex-grow: 0;">
        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
            <ui:TextField label="Detached From" readonly="true" enabled="false" style="flex-grow: 1;">
                <Bindings>
                    <ui:DataBinding property="value" data-source-path="detachedFromGroupName" binding-mode="ToTarget" />
                </Bindings>
            </ui:TextField>
            <ui:Button text="Set" name="SetDetachedFromGroupButton">
                <Bindings>
                    <ui:DataBinding property="enabledSelf" data-source-path="isInEditMode" binding-mode="ToTarget" />
                </Bindings>
            </ui:Button>
            <ui:Button text="Reattach" name="ReattachToDetachedFromGroupButton">
                <Bindings>
                    <ui:DataBinding property="enabledSelf" data-source-path="canReattachToDetachedGroup" binding-mode="ToTarget" />
                </Bindings>
            </ui:Button>
        </ui:VisualElement>
        <ui:Toggle label="Enable Auto Reattach">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="enableAutoReattach" binding-mode="TwoWay" />
            </Bindings>
        </ui:Toggle>
    </ui:VisualElement>
</ui:UXML>
