<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement data-source-type="StrategicCombatCore.StrategicGroup, Assembly-CSharp" style="flex-grow: 0;">
        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
            <ui:Label text="Parent">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(11054955223486464)" />
                </Bindings>
            </ui:Label>
            <ui:Button text="Parent Name" name="GotoParentButton" style="flex-grow: 1;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="parentName" binding-mode="ToTarget" />
                </Bindings>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
            <ui:Label text="Source Depot">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:7dfd13ea0ff0ef0408a7f015356a0054" entry="Id(11054514137894912)" />
                </Bindings>
            </ui:Label>
            <ui:Button text="Current Source Depot Name" name="CurrentSourceDepotButton" style="flex-grow: 1;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="currentSourceDepotName" binding-mode="ToTarget" />
                </Bindings>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
