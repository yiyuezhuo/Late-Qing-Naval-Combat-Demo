<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement data-source-type="StrategicCombatCore.LandBattleSideStateDynamic+LandUnitBundle, Assembly-CSharp" style="flex-direction: row;">
        <ui:VisualElement style="flex-basis: 36px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); -unity-background-scale-mode: stretch-to-fill; flex-shrink: 0; margin-bottom: 2px; margin-top: 2px; margin-left: 1px;">
            <Bindings>
                <ui:DataBinding property="style.backgroundImage" data-source-path="icon" binding-mode="ToTarget" />
            </Bindings>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1;">
            <ui:Label text="desc" data-source-type="StrategicCombatCore.LandBattleSideStateDynamic+LandUnitBundle, Assembly-CSharp" style="font-size: 12px; margin-bottom: 0; margin-top: 0;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="desc" binding-mode="ToTarget" />
                </Bindings>
            </ui:Label>
            <ui:Label text="desc2" style="font-size: 12px; margin-bottom: 0; margin-top: 0;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="desc2" binding-mode="ToTarget" />
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
