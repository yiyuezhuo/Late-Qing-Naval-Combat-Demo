<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement data-source-type="StrategicCombatCore.LandBattleSideStateDynamic+LandUnitBundle, Assembly-CSharp" style="flex-direction: row;">
        <ui:VisualElement class="hud-image-frame" style="flex-basis: 36px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); -unity-background-scale-mode: stretch-to-fill; flex-shrink: 0; margin-bottom: 2px; margin-top: 2px; margin-left: 1px; background-color: rgb(255, 255, 255);">
            <Bindings>
                <ui:DataBinding property="style.backgroundImage" data-source-path="icon" binding-mode="ToTarget" />
            </Bindings>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                <ui:Label text="name" name="NameLabel" style="font-size: 12px; margin-top: 1px; margin-bottom: 0; white-space: normal;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="descLink" binding-mode="ToTarget" />
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:Label text="desc2" style="font-size: 12px; margin-bottom: 0; margin-top: 0;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="desc2" binding-mode="ToTarget" />
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement>
            <ui:VisualElement style="flex-basis: 2px;" />
            <ui:VisualElement style="flex-shrink: 0; flex-direction: row; flex-grow: 1;">
                <ui:VisualElement style="flex-grow: 0; flex-basis: 5px; flex-shrink: 0; flex-direction: column-reverse;">
                    <ui:VisualElement style="background-color: rgb(61, 184, 0); min-height: 50%;">
                        <Bindings>
                            <ui:DataBinding property="style.minHeight" data-source-path="strengthPercent" binding-mode="ToTarget" />
                        </Bindings>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 0; flex-basis: 5px; flex-shrink: 0; flex-direction: column-reverse;">
                    <ui:VisualElement style="background-color: rgb(82, 81, 81); min-height: 50%;">
                        <Bindings>
                            <ui:DataBinding property="style.minHeight" data-source-path="suppressionSuppPercent" binding-mode="ToTarget" />
                        </Bindings>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 0; flex-basis: 5px; flex-shrink: 0; flex-direction: column-reverse;">
                    <ui:VisualElement style="background-color: rgb(255, 0, 0); min-height: 50%;">
                        <Bindings>
                            <ui:DataBinding property="style.minHeight" data-source-path="moralePercent" binding-mode="ToTarget" />
                        </Bindings>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 0; flex-basis: 5px; flex-shrink: 0; flex-direction: column-reverse;">
                    <ui:VisualElement style="background-color: rgb(255, 126, 0); min-height: 50%;">
                        <Bindings>
                            <ui:DataBinding property="style.minHeight" data-source-path="fatigueSuppPercent" binding-mode="ToTarget" />
                        </Bindings>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
