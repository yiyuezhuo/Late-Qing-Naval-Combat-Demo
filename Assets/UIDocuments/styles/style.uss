    border-bottom-width: 1px;
    border-bottom-color: rgb(110, 97, 72);
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
}

.hud-image-frame {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(124, 109, 80);
    border-right-color: rgb(124, 109, 80);
    border-top-color: rgb(185, 167, 120);
    border-bottom-color: rgb(72, 62, 46);
    background-color: rgb(20, 22, 25);
}

.log-label {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 10px;
    white-space: normal;
    color: rgb(223, 217, 203);
}

.unity-label,
.unity-text-element {
    color: rgb(236, 229, 214);
}

.unity-button {
    background-color: rgb(58, 62, 68);
    color: rgb(236, 229, 214);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(80, 71, 54);
    border-right-color: rgb(80, 71, 54);
    border-top-color: rgb(152, 137, 102);
    border-bottom-color: rgb(58, 51, 38);
