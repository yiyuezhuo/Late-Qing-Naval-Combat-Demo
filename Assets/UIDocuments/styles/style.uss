}

.unity-toggle__checkmark {
    background-color: rgb(42, 46, 51);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(86, 76, 58);
    border-right-color: rgb(86, 76, 58);
    border-top-color: rgb(136, 122, 92);
    border-bottom-color: rgb(60, 52, 39);
