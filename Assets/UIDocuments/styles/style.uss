    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
}

.hud-statusbar {
    background-color: rgba(28, 31, 36, 0.85);
    border-top-width: 1px;
    border-top-color: rgb(100, 88, 66);
    padding-left: 6px;
    padding-right: 6px;
