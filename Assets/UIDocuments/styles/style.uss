.unity-base-field__input {
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 2px;
    padding-right: 2px;
}

.unity-label {
    padding-top: 1px;
    padding-bottom: 1px;
    margin-top: 1px;
    margin-bottom: 1px;
}

.unity-button {
    padding-top: 1px;
    padding-bottom: 1px;
}

.unity-button.large {
    padding-bottom: 6px;
    padding-top: 6px;
}

.unity-button.verylarge {
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 20px;
    margin-bottom: 4px;
    margin-top: 4px;
}

.unity-float-field {
    min-width: 35px;
}

.unity-tab-view__content-viewport {
    flex-shrink: 0;
}

.unity-tab-view.grow .unity-tab__content-container {
    flex-grow: 1;
}

.unity-tab-view.grow .unity-tab-view__content-container {
    flex-grow: 1;
}

.unity-tab-view.grow .unity-tab {
    flex-grow: 1;
}

.unity-multi-column-header {
    height: 23px;
    min-height: 23px;
}

.unity-foldout__toggle {
    height: 24px;
    max-height: 24px;
    min-height: 24px;
}

.unity-toggle__checkmark {
    width: 18px;
    height: 18px;
}

.unity-radio-button__checkmark-background {
    width: 18px;
    height: 18px;
    padding-top: 3px;
    padding-bottom: 0;
    padding-left: 1px;
    padding-right: 1px;
}

.unity-radio-button__checkmark {
    width: 9px;
    height: 9px;
}

.unity-toggle__checkmark.unity-foldout__checkmark {
    margin-right: 0;
    margin-left: 0;
}

.unity-enum-field__text {
    padding-right: 0;
    margin-right: 5px;
}

.unity-base-popup-field__text {
    margin-right: 5px;
}

.unity-text-element.unity-label.unity-base-dropdown__label {
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
    padding-top: 1px;
    padding-right: 1px;
    padding-bottom: 1px;
    padding-left: 1px;
}

.unity-base-dropdown__label {
    margin-left: 1px;
    margin-bottom: 1px;
    margin-right: 1px;
    margin-top: 1px;
    padding-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
}

.unity-collection-view:focus:enabled.unity-collection-view__item--selected {
    color: rgb(244, 236, 220);
    background-color: rgba(90, 80, 60, 0.9);
}

.unity-collection-view__item--selected:hover:enabled {
    color: rgb(244, 236, 220);
    background-color: rgba(110, 97, 72, 0.9);
}

.unity-collection-view:focus:enabled .unity-collection-view__item--selected {
    background-color: rgba(90, 80, 60, 0.9);
    color: rgb(244, 236, 220);
}

.link-cursor {
    cursor: url("project://database/Assets/Textures/NavalCombat/signal_flag.png?fileID=2800000&guid=872ba5279dbe95746b30f77407926404&type=3#signal_flag");
}

.long-dropdown {
    width: 150px;
}

.size50 .unity-label {
    min-width: 50px;
}

.fix-height-float-field-container .unity-float-field {
    height: 20px;
}

.x-button {
    padding-left: 5px;
    padding-right: 5px;
}

.border-box {
    border-left-color: rgb(124, 109, 80);
    border-right-color: rgb(124, 109, 80);
    border-top-color: rgb(185, 167, 120);
    border-bottom-color: rgb(72, 62, 46);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-top: 1px;
    margin-right: 1px;
}

.battery-arc-indicator {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(124, 109, 80);
    border-right-color: rgb(124, 109, 80);
    border-top-color: rgb(185, 167, 120);
    border-bottom-color: rgb(72, 62, 46);
    width: 30px;
    height: 100px;
}

.title {
    padding-left: 8px;
    padding-top: 2px;
    margin-top: 0;
    margin-left: 0;
    padding-right: 8px;
    margin-right: 0;
    padding-bottom: 3px;
    margin-bottom: 2px;
    background-color: rgb(63, 67, 72);
    color: rgb(236, 229, 214);
    border-bottom-width: 1px;
    border-bottom-color: rgb(140, 122, 86);
    border-top-width: 1px;
    border-top-color: rgb(92, 82, 62);
}

.panel {
    background-color: rgb(43, 47, 52);
    color: rgb(236, 229, 214);
    flex-grow: 1;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(124, 109, 80);
    border-right-color: rgb(124, 109, 80);
    border-top-color: rgb(185, 167, 120);
    border-bottom-color: rgb(72, 62, 46);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

.panel-dialog {
    background-color: rgb(40, 44, 49);
    flex-grow: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(124, 109, 80);
    border-right-color: rgb(124, 109, 80);
    border-top-color: rgb(185, 167, 120);
    border-bottom-color: rgb(72, 62, 46);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    width: 400px;
