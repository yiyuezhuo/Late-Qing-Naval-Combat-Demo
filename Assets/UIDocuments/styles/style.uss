}

.panel-major-dialog {
    background-color: rgb(40, 44, 49);
    flex-grow: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(124, 109, 80);
    border-right-color: rgb(124, 109, 80);
    border-top-color: rgb(185, 167, 120);
    border-bottom-color: rgb(72, 62, 46);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    width: 900px;
    height: 600px;
    max-height: 600px;
}

.hud-topbar {
    background-color: rgba(36, 40, 45, 0.92);
    border-top-width: 1px;
