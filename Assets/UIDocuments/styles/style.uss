}

.unity-tab-view {
    background-color: rgba(29, 33, 38, 0.8);
}

.unity-tab {
    background-color: rgb(52, 56, 62);
    border-top-width: 1px;
    border-right-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(120, 106, 78);
    border-left-color: rgb(120, 106, 78);
    border-right-color: rgb(78, 69, 52);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    color: rgb(226, 219, 204);
}

.unity-tab--selected {
    background-color: rgb(74, 79, 86);
    color: rgb(244, 236, 220);
}

.unity-progress-bar__background {
    background-color: rgb(23, 25, 28);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(86, 76, 58);
    border-right-color: rgb(86, 76, 58);
    border-top-color: rgb(136, 122, 92);
    border-bottom-color: rgb(60, 52, 39);
}

.unity-progress-bar__progress {
