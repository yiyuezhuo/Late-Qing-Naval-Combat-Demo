:root {
    --ui-border-panel-side: rgb(124, 109, 80);
    --ui-border-input-side: rgb(86, 76, 58);
    --ui-border-panel-bottom: rgb(72, 62, 46);
    --ui-border-panel-top: rgb(185, 167, 120);
    --ui-text-primary: rgb(236, 229, 214);
    --ui-border-input-top: rgb(136, 122, 92);
    --ui-text-selected: rgb(236, 229, 214);
    --ui-border-input-bottom: rgb(60, 52, 39);
    --ui-surface-scroll-overlay: rgba(28, 31, 36, 0.7);
    --ui-border-tab-top: rgb(120, 106, 78);
    --ui-surface-button: rgb(58, 62, 68);
    --ui-border-transparent: rgba(0, 0, 0, 0);
    --ui-border-divider: rgb(110, 97, 72);
    --ui-surface-selection: rgba(70, 62, 47, 0.95);
    --ui-surface-disabled: rgb(52, 56, 62);
    --ui-icon-accent: rgb(214, 196, 150);
    --ui-border-button-side: rgb(80, 71, 54);
    --ui-surface-dialog: rgb(40, 44, 49);
    --ui-border-button-bottom: rgb(58, 51, 38);
    --ui-surface-panel: rgb(43, 47, 52);
    --ui-surface-tab-selected: rgb(74, 79, 86);
    --ui-surface-log-header: rgba(55, 59, 65, 0.9);
    --ui-surface-selection-hover: rgba(88, 78, 58, 0.95);
    --ui-surface-list-hover: rgb(64, 69, 76);
    --ui-text-tab: rgb(226, 219, 204);
    --ui-surface-progress-track: rgb(23, 25, 28);
    --ui-surface-log-panel: rgba(32, 36, 41, 0.9);
    --ui-surface-progress-fill: rgb(164, 128, 74);
    --ui-border-tab-right: rgb(78, 69, 52);
    --ui-surface-list: rgb(28, 31, 36);
    --ui-surface-dropdown: rgb(32, 36, 41);
    --ui-surface-popup: rgb(30, 33, 37);
    --ui-border-statusbar-top: rgb(100, 88, 66);
    --ui-surface-topbar: rgba(36, 40, 45, 0.92);
    --ui-text-disabled: rgb(143, 136, 122);
    --ui-surface-button-hover: rgb(72, 77, 84);
    --ui-surface-info-panel: rgba(35, 38, 43, 0.95);
    --ui-text-log: rgb(223, 217, 203);
    --ui-surface-button-active: rgb(44, 48, 53);
    --ui-border-title-top: rgb(92, 82, 62);
    --ui-border-topbar-top: rgb(93, 83, 63);
    --ui-surface-slider-handle: rgb(120, 103, 74);
    --ui-text-progress-title: rgb(233, 226, 210);
    --ui-surface-slider-track: rgb(45, 48, 53);
    --ui-surface-image-frame: rgb(20, 22, 25);
    --ui-surface-statusbar: rgba(28, 31, 36, 0.85);
    --ui-border-button-top: rgb(152, 137, 102);
    --ui-border-title-bottom: rgb(140, 122, 86);
    --ui-surface-title: rgb(63, 67, 72);
    --ui-surface-toggle: rgb(42, 46, 51);
    --ui-surface-tabview: rgba(29, 33, 38, 0.8);
    --ui-text-label: rgb(210, 202, 186);
    --ui-surface-input: rgb(26, 29, 33);
    --ui-surface-scroller-button: rgb(46, 50, 55);
    --ui-main-menu-background-tint: rgb(50, 50, 50);
    --strategic-unit-icon-text-color: rgb(0, 0, 0);
    --ui-surface-weapon-card: rgba(27, 30, 34, 0.88);
    --ui-surface-weapon-card-title: rgba(66, 72, 80, 0.9);
    --ui-border-weapon-card-side: rgb(97, 86, 64);
    --ui-border-weapon-card-top: rgb(150, 136, 102);
    --ui-border-weapon-card-bottom: rgb(66, 58, 43);
    --ui-text-weapon-title: rgb(237, 227, 207);
}

.unity-base-field__input {
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 2px;
    padding-right: 2px;
}

.unity-label {
    padding-top: 1px;
    padding-bottom: 1px;
    margin-top: 1px;
    margin-bottom: 1px;
}

.unity-button {
    padding-top: 1px;
    padding-bottom: 1px;
}

.unity-button.large {
    padding-bottom: 6px;
    padding-top: 6px;
}

.unity-button.verylarge {
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 20px;
    margin-bottom: 4px;
    margin-top: 4px;
}

.unity-float-field {
    min-width: 35px;
}

.unity-tab-view__content-viewport {
    flex-shrink: 0;
}

.unity-tab-view.grow .unity-tab__content-container {
    flex-grow: 1;
}

.unity-tab-view.grow .unity-tab-view__content-container {
    flex-grow: 1;
}

.unity-tab-view.grow .unity-tab {
    flex-grow: 1;
}

.unity-multi-column-header {
    height: 23px;
    min-height: 23px;
}

.unity-foldout__toggle {
    height: 24px;
    max-height: 24px;
    min-height: 24px;
}

.unity-toggle__checkmark {
    width: 18px;
    height: 18px;
}

.unity-radio-button__checkmark-background {
    width: 18px;
    height: 18px;
    padding-top: 3px;
    padding-bottom: 0;
    padding-left: 1px;
    padding-right: 1px;
}

.unity-radio-button__checkmark {
    width: 9px;
    height: 9px;
}

.unity-toggle__checkmark.unity-foldout__checkmark {
    margin-right: 0;
    margin-left: 0;
}

.unity-enum-field__text {
    padding-right: 0;
    margin-right: 5px;
}

.unity-base-popup-field__text {
    margin-right: 5px;
}

.unity-text-element.unity-label.unity-base-dropdown__label {
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
    padding-top: 1px;
    padding-right: 1px;
    padding-bottom: 1px;
    padding-left: 1px;
}

.unity-base-dropdown__label {
    margin-left: 1px;
    margin-bottom: 1px;
    margin-right: 1px;
    margin-top: 1px;
    padding-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
}

.unity-collection-view:focus:enabled.unity-collection-view__item--selected {
    color: var(--ui-text-selected);
    background-color: var(--ui-surface-selection);
}

.unity-collection-view__item--selected:hover:enabled {
    color: var(--ui-text-selected);
    background-color: var(--ui-surface-selection-hover);
}

.unity-collection-view__item--selected:enabled {
    color: var(--ui-text-selected);
    background-color: var(--ui-surface-selection);
}

.unity-collection-view__item:hover:enabled {
    background-color: var(--ui-surface-button-hover);
}


.unity-collection-view:focus:enabled .unity-collection-view__item--selected {
    background-color: var(--ui-surface-selection);
    color: var(--ui-text-selected);
}

.link-cursor {
    cursor: url("project://database/Assets/Textures/NavalCombat/signal_flag.png?fileID=2800000&guid=872ba5279dbe95746b30f77407926404&type=3#signal_flag");
}

.long-dropdown {
    width: 150px;
}

.size50 .unity-label {
    min-width: 50px;
}

.fix-height-float-field-container .unity-float-field {
    height: 20px;
}

.x-button {
    padding-left: 5px;
    padding-right: 5px;
}

.border-box {
    border-left-color: var(--ui-border-panel-side);
    border-right-color: var(--ui-border-panel-side);
    border-top-color: var(--ui-border-panel-top);
    border-bottom-color: var(--ui-border-panel-bottom);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-top: 1px;
    margin-right: 1px;
}

.battery-arc-indicator {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-panel-side);
    border-right-color: var(--ui-border-panel-side);
    border-top-color: var(--ui-border-panel-top);
    border-bottom-color: var(--ui-border-panel-bottom);
    width: 30px;
    height: 100px;
}

.title {
    padding-left: 8px;
    padding-top: 2px;
    margin-top: 0;
    margin-left: 0;
    padding-right: 8px;
    margin-right: 0;
    padding-bottom: 3px;
    margin-bottom: 2px;
    background-color: var(--ui-surface-title);
    color: var(--ui-text-primary);
    border-bottom-width: 1px;
    border-bottom-color: var(--ui-border-title-bottom);
    border-top-width: 1px;
    border-top-color: var(--ui-border-title-top);
}

.main-menu-panel {
    background-color: var(--ui-surface-info-panel);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-panel-side);
    border-right-color: var(--ui-border-panel-side);
    border-top-color: var(--ui-border-panel-top);
    border-bottom-color: var(--ui-border-panel-bottom);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

.main-menu-title {
    font-size: 42px;
    -unity-text-align: upper-center;
    color: var(--ui-text-selected);
    margin-bottom: 2px;
}

.main-menu-subtitle {
    font-size: 30px;
    -unity-text-align: upper-center;
    color: var(--ui-text-primary);
    margin-bottom: 8px;
}

.main-menu-column-title {
    -unity-text-align: upper-center;
    color: var(--ui-text-selected);
    font-size: 14px;
    margin-top: 6px;
    margin-bottom: 6px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.panel {
    background-color: var(--ui-surface-panel);
    color: var(--ui-text-primary);
    flex-grow: 1;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-panel-side);
    border-right-color: var(--ui-border-panel-side);
    border-top-color: var(--ui-border-panel-top);
    border-bottom-color: var(--ui-border-panel-bottom);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

.panel-dialog {
    background-color: var(--ui-surface-dialog);
    flex-grow: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-panel-side);
    border-right-color: var(--ui-border-panel-side);
    border-top-color: var(--ui-border-panel-top);
    border-bottom-color: var(--ui-border-panel-bottom);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    width: 400px;
    height: 400px;
}

.panel-major-dialog {
    background-color: var(--ui-surface-dialog);
    flex-grow: 0;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-panel-side);
    border-right-color: var(--ui-border-panel-side);
    border-top-color: var(--ui-border-panel-top);
    border-bottom-color: var(--ui-border-panel-bottom);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    width: 900px;
    height: 600px;
    max-height: 600px;
}

.hud-topbar {
    background-color: var(--ui-surface-topbar);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: var(--ui-border-topbar-top);
    border-bottom-color: var(--ui-border-panel-side);
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: var(--ui-border-transparent);
    border-right-color: var(--ui-border-transparent);
}

.hud-info-panel {
    background-color: var(--ui-surface-info-panel);
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
}

.weapon-summary-group {
    margin-top: 4px;
}

.weapon-summary-card {
    background-color: var(--ui-surface-weapon-card);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-weapon-card-side);
    border-right-color: var(--ui-border-weapon-card-side);
    border-top-color: var(--ui-border-weapon-card-top);
    border-bottom-color: var(--ui-border-weapon-card-bottom);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-bottom: 3px;
}

.weapon-summary-title {
    background-color: var(--ui-surface-weapon-card-title);
    color: var(--ui-text-weapon-title);
    border-bottom-width: 1px;
    border-bottom-color: var(--ui-border-weapon-card-side);
    padding-top: 1px;
    padding-bottom: 2px;
    padding-left: 5px;
    padding-right: 5px;
    margin-top: 0;
    margin-bottom: 2px;
}

.weapon-summary-content {
    white-space: normal;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 5px;
    padding-right: 5px;
}

.hud-statusbar {
    background-color: var(--ui-surface-statusbar);
    border-top-width: 1px;
    border-top-color: var(--ui-border-statusbar-top);
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.hud-log-panel {
    background-color: var(--ui-surface-log-panel);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-panel-side);
    border-right-color: var(--ui-border-panel-side);
    border-top-color: var(--ui-border-panel-top);
    border-bottom-color: var(--ui-border-panel-bottom);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
}

.hud-log-header {
    background-color: var(--ui-surface-log-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--ui-border-divider);
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
}

.hud-image-frame {
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-panel-side);
    border-right-color: var(--ui-border-panel-side);
    border-top-color: var(--ui-border-panel-top);
    border-bottom-color: var(--ui-border-panel-bottom);
    background-color: var(--ui-surface-image-frame);
}

.log-label {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 10px;
    white-space: normal;
    color: var(--ui-text-log);
}

.unity-label,
.unity-text-element {
    color: var(--ui-text-primary);
}

.unity-button {
    background-color: var(--ui-surface-button);
    color: var(--ui-text-primary);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-button-side);
    border-right-color: var(--ui-border-button-side);
    border-top-color: var(--ui-border-button-top);
    border-bottom-color: var(--ui-border-button-bottom);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

/*
.unity-button:hover:enabled {
    background-color: var(--ui-surface-button-hover);
}
*/

.unity-button:hover:enabled {
    background-color: var(--ui-surface-button-hover);
    color: var(--ui-text-primary);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-button-side);
    border-right-color: var(--ui-border-button-side);
    border-top-color: var(--ui-border-button-top);
    border-bottom-color: var(--ui-border-button-bottom);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}


.unity-button:active {
    background-color: var(--ui-surface-button-active);
}

.unity-button:disabled {
    background-color: var(--ui-surface-disabled);
    color: var(--ui-text-disabled);
}

.unity-base-field:disabled .unity-base-field__input,
.unity-base-field__input:disabled {
    background-color: var(--ui-surface-disabled);
    color: var(--ui-text-disabled);
}

.unity-base-field:disabled .unity-label,
.unity-base-field__label:disabled {
    color: var(--ui-text-disabled);
}

.unity-base-field__input {
    background-color: var(--ui-surface-input);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-input-side);
    border-right-color: var(--ui-border-input-side);
    border-top-color: var(--ui-border-input-top);
    border-bottom-color: var(--ui-border-input-bottom);
}

.unity-text-element--inner-input-field-component {
    color: var(--ui-text-primary);
}

.unity-base-field__label {
    color: var(--ui-text-label);
}

.unity-base-popup-field__input,
.unity-enum-field__input {
    background-color: var(--ui-surface-popup);
}

.unity-base-popup-field:hover:enabled > .unity-base-popup-field__input {
    background-color: var(--ui-surface-selection-hover);
}

.unity-base-dropdown__container-inner {
    background-color: var(--ui-surface-dropdown);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-panel-side);
    border-right-color: var(--ui-border-panel-side);
    border-top-color: var(--ui-border-panel-top);
    border-bottom-color: var(--ui-border-panel-bottom);
}

.unity-base-dropdown__item {
    color: var(--ui-text-primary);
}

.unity-base-dropdown__item:hover:enabled {
    background-color: var(--ui-surface-list-hover);
}

.unity-base-dropdown__item:checked {
    background-color: var(--ui-surface-selection);
    color: var(--ui-text-selected);
}

.unity-base-dropdown__item:checked:hover:enabled {
    background-color: var(--ui-surface-selection-hover);
}

.unity-base-dropdown__item:hover:enabled {
    background-color: var(--ui-surface-selection-hover);
}

.unity-scroll-view {
    background-color: var(--ui-surface-scroll-overlay);
}

.main-menu-background {
    -unity-background-image-tint-color: var(--ui-main-menu-background-tint);
}

.unity-scroll-view__content-viewport {
    background-color: var(--ui-surface-scroll-overlay);
}

.unity-collection-view {
    background-color: var(--ui-border-transparent);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-input-side);
    border-right-color: var(--ui-border-input-side);
    border-top-color: var(--ui-border-input-top);
    border-bottom-color: var(--ui-border-input-bottom);
}

.unity-multi-column-header {
    background-color: var(--ui-surface-button);
    border-bottom-width: 1px;
    border-bottom-color: var(--ui-border-divider);
}

.unity-multi-column-view__header-container {
    background-color: var(--ui-surface-button);
    border-bottom-width: 1px;
    border-bottom-color: var(--ui-border-divider);
}

.unity-multi-column-header__column {
    background-color: var(--ui-surface-button);
    color: var(--ui-text-primary);
    border-right-width: 1px;
    border-right-color: var(--ui-border-input-side);
}

.unity-list-view__footer {
    background-color: var(--ui-surface-scroll-overlay);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

#unity-list-view__add-button,
#unity-list-view__remove-button {
    background-color: var(--ui-surface-button);
    color: var(--ui-text-primary);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-button-side);
    border-right-color: var(--ui-border-button-side);
    border-top-color: var(--ui-border-button-top);
    border-bottom-color: var(--ui-border-button-bottom);
}

#unity-list-view__add-button:hover,
#unity-list-view__remove-button:hover {
    background-color: var(--ui-surface-button-hover);
}

#unity-list-view__add-button:active,
#unity-list-view__remove-button:active {
    background-color: var(--ui-surface-button-active);
}

#unity-list-view__add-button:disabled,
#unity-list-view__remove-button:disabled {
    background-color: var(--ui-surface-disabled);
    color: var(--ui-text-disabled);
}

.unity-tab-view {
    background-color: var(--ui-surface-tabview);
}

.unity-tab-view__header-container,
.unity-tab-view__content-container,
.unity-tab__content-container {
    background-color: var(--ui-surface-tabview);
}

.unity-tab-view__header-container {
    border-bottom-width: 0;
}

.unity-tab-view__content-container {
    border-top-width: 0;
}

.unity-tab__header {
    background-color: var(--ui-surface-button);
    color: var(--ui-text-tab);
    border-top-width: 1px;
    border-right-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ui-border-tab-top);
    border-left-color: var(--ui-border-tab-top);
    border-right-color: var(--ui-border-tab-right);
    border-bottom-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

.unity-tab__header:hover {
    background-color: var(--ui-surface-button-hover);
}

.unity-tab__header:checked {
    background-color: var(--ui-surface-tabview);
    color: var(--ui-text-selected);
}

.unity-tab {
    background-color: var(--ui-surface-tabview);
    border-top-width: 0;
    border-right-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--ui-border-tab-top);
    border-left-color: var(--ui-border-tab-top);
    border-right-color: var(--ui-border-tab-right);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    color: var(--ui-text-tab);
}

.unity-tab--selected {
    background-color: var(--ui-surface-tabview);
    color: var(--ui-text-selected);
}

.unity-progress-bar__background {
    background-color: var(--ui-surface-progress-track);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-input-side);
    border-right-color: var(--ui-border-input-side);
    border-top-color: var(--ui-border-input-top);
    border-bottom-color: var(--ui-border-input-bottom);
}

.unity-progress-bar__progress {
    background-color: var(--ui-surface-progress-fill);
}

.unity-progress-bar__title {
    color: var(--ui-text-progress-title);
}

.unity-toggle__checkmark {
    background-color: var(--ui-surface-toggle);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-input-side);
    border-right-color: var(--ui-border-input-side);
    border-top-color: var(--ui-border-input-top);
    border-bottom-color: var(--ui-border-input-bottom);
    -unity-background-image-tint-color: var(--ui-icon-accent);
}

.unity-radio-button {
    color: var(--ui-text-label);
}

.unity-radio-button__checkmark-background {
    background-color: var(--ui-surface-toggle);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: var(--ui-border-input-side);
    border-right-color: var(--ui-border-input-side);
    border-top-color: var(--ui-border-input-top);
    border-bottom-color: var(--ui-border-input-bottom);
}

.unity-radio-button__checkmark {
    background-color: var(--ui-border-transparent);
}

.unity-radio-button:checked .unity-radio-button__checkmark {
    background-color: var(--ui-icon-accent);
}

.unity-scroller > .unity-scroller__low-button,
.unity-scroller > .unity-scroller__high-button {
    background-color: var(--ui-surface-scroller-button);
    -unity-background-image-tint-color: var(--ui-icon-accent);
}

.unity-base-slider__drag-container > #unity-tracker {
    background-color: var(--ui-surface-slider-track);
}

.unity-base-slider__drag-container > #unity-dragger {
    background-color: var(--ui-surface-slider-handle);
}



.strategic-unit-icon-box > .unity-label {
    color: var(--strategic-unit-icon-text-color);
}
