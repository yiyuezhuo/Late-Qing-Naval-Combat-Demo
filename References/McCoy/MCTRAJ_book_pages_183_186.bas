4010 REM SUBROUTINE FOR INTERPOLATION IN DRAG TABLE
4020 I=1
4030 IF (I+1)>MM1 THEN 4130
4040 IF X1<M(I+1) THEN 4070
4050 I=I+1
4060 GOTO 4030
4070 S=(D(I+1)-D(I))/(M(I+1)-M(I))
4080 X2=D(I)+S*(X1-M(I))
4090 RETURN
4100 PRINT: PRINT
